#!/bin/sh
# E5: the speaker volume, 16 levels (0 mute - 15), kept in
# /etc/config/e5-audio (main.volume) and applied to the digital gain of the
# speaker path, 'VBC DAC0 DG Set' (0-127, both channels).  Level 15 is 39,
# the gain the device's own Android plays media with (the UCM profile's
# value, rootfs/overlay/usr/share/alsa/ucm2/sprdphone-sc273/HiFi.conf), and
# each level below takes 2 off: 11 at level 1.  Never louder than Android.
#
#   e5-volume                 the level, as JSON: {"level":N,"max":15,"card":true|false}
#   e5-volume set N | up | down
#   e5-volume apply           the saved level to the card (after e5-audio-dsp start)
#   e5-volume play FILE|beep   play a sound (not while one is playing)
MAX=15
CTL='VBC DAC0 DG Set'

card() { awk '/sprdphone/ {print $1; exit}' /proc/asound/cards 2>/dev/null; }
level() {
	local l
	l=$(uci -q get e5-audio.main.volume)
	case "$l" in ''|*[!0-9]*) l=10 ;; esac
	[ "$l" -gt $MAX ] && l=$MAX
	echo "$l"
}
gain() { [ "$1" -le 0 ] && echo 0 || echo $((39 - (MAX - $1) * 2)); }
apply() {
	local c g
	c=$(card); [ -n "$c" ] || return 1
	g=$(gain "$1")
	amixer -q -c "$c" cset "name=$CTL" "$g,$g" >/dev/null 2>&1
}
status() {
	printf '{"level":%d,"max":%d,"card":%s}\n' "$(level)" $MAX "$([ -n "$(card)" ] && echo true || echo false)"
}
save() {
	uci -q set e5-audio.main=audio
	uci set e5-audio.main.volume="$1"
	uci commit e5-audio
}
play() {
	local c f=$1
	case "$f" in beep) f=/usr/share/e5/beep.wav ;; esac
	c=$(card); [ -n "$c" ] && [ -f "$f" ] || return 1
	[ "$(level)" -gt 0 ] || return 0
	pidof aplay >/dev/null && return 0
	aplay -q -D "hw:$c,3" "$f" >/dev/null 2>&1 &
}

case "${1:-}" in
	'') status ;;
	set) n=${2:-}; case "$n" in ''|*[!0-9]*) echo "a level 0-$MAX" >&2; exit 2 ;; esac
	     [ "$n" -gt $MAX ] && n=$MAX; save "$n"; apply "$n"; status ;;
	up) n=$(level); [ "$n" -lt $MAX ] && n=$((n + 1)); save "$n"; apply "$n"; status ;;
	down) n=$(level); [ "$n" -gt 0 ] && n=$((n - 1)); save "$n"; apply "$n"; status ;;
	apply) apply "$(level)" ;;
	play) play "${2:-beep}" ;;
	*) sed -n '2,15p' "$0"; exit 2 ;;
esac
