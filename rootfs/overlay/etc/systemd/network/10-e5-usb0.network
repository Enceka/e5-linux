[Match]
Name=usb0

[Network]
# The management LAN the initramfs also sets up: usb0 gets its address here, and
# the leases come from dnsmasq -- not from networkd (whose DHCPServer never
# gets as far as starting on this kernel) and not from the initramfs's
# standalone udhcpd.  See /etc/dnsmasq.d/e5-hotspot.conf.
Address=192.168.77.1/24
# No DHCPServer= on purpose: it never starts on this kernel (see the note about
# the rtnl timeouts in dnsmasq.d/e5-hotspot.conf), and dnsmasq serves this LAN
# anyway.
IPv6AcceptRA=no
