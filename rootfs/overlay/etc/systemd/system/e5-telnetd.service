[Unit]
Description=BusyBox telnetd on the USB management LAN
After=e5-net-bridge.service
# Enabled by rootfs/device-finalize.sh at image build time: the overlay travels
# into the initramfs as plain files and cannot carry enable symlinks.  It arrives
# with systemd-networkd, which brings up usb0 and its DHCP server.
[Service]
Type=simple
ExecStart=/usr/local/bin/busybox telnetd -F -p 23 -l /bin/login
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
