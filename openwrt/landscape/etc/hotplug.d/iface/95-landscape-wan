#!/bin/sh
# sipa_eth0 is a raw-IP bearer whose address changes on every reconnect.
# Landscape's WAN link is static because a DHCP client would need a MAC this
# device does not have, so keep the link's address in step with the kernel.
#
# The work lives in one helper: the service runs it from boot (the daemon
# writes its API token and the modem attaches at different moments), and this
# hook is only a prompt to run it now.

[ -x /usr/libexec/landscape-wan-sync ] || exit 0

case "$ACTION" in
	ifup|ifupdate) ;;
	*) exit 0 ;;
esac

[ "$DEVICE" = sipa_eth0 ] || exit 0

exec /usr/libexec/landscape-wan-sync
