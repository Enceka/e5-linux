#!/bin/sh /etc/rc.common
# The sound card and the audio DSP (e5-audio.service on Debian): the vendor
# audio modules, the AGDSP image, the DSP profiles and the speaker route
# (/opt/e5/e5-audio-dsp start), then the saved volume (/usr/libexec/e5-volume).
# Once per boot, in the background: the card waits out deferred probes.
START=97
USE_PROCD=1

start_service() {
	[ "$(uci -q get e5-audio.main.enabled)" = 0 ] && return 0
	procd_open_instance
	procd_set_param command /bin/sh -c '/opt/e5/e5-audio-dsp start && /usr/libexec/e5-volume apply'
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
