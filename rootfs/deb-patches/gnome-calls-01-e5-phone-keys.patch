+static gboolean
+on_phone_key (GtkEventControllerKey *controller, guint keyval, guint keycode,
+              GdkModifierType state, CallsCallWindow *self)
+{
+  GtkWidget *widget = gtk_stack_get_visible_child (self->call_stack);
+  CuiCall *call;
+  if (keyval != GDK_KEY_Phone && keyval != GDK_KEY_PickupPhone &&
+      keyval != GDK_KEY_HangupPhone)
+    return GDK_EVENT_PROPAGATE;
+  if (!CUI_IS_CALL_DISPLAY (widget))
+    return GDK_EVENT_STOP;
+  call = cui_call_display_get_call (CUI_CALL_DISPLAY (widget));
+  if (keyval == GDK_KEY_HangupPhone)
+    cui_call_hang_up (call);
+  else if (cui_call_get_state (call) == CUI_CALL_STATE_INCOMING)
+    cui_call_accept (call);
+  return GDK_EVENT_STOP;
+}
+
