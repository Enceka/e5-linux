[Match]
Name=wlan0

[Network]
Address=192.168.9.1/24
DHCPServer=yes

[DHCPServer]
# The E5 runs no DNS server (no dnsmasq, no systemd-resolved), so advertising our own
# address would leave clients with a resolver that never answers -- "got an address, no
# internet".  hotspot-start.sh writes the nameservers /etc/resolv.conf actually has into
# a drop-in next to this file instead.
EmitDNS=no
PoolOffset=10
PoolSize=20
