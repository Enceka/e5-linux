#!/bin/sh
# Notify the existing MM owner without waiting behind unrelated hotplug work.
# No AT commands, radio changes, extra daemon or polling are used here.
[ -r /sys/module/sipc_wwan/parameters/card ] || exit 0
case "$(cat /sys/module/sipc_wwan/parameters/card)" in
    0) base=0; other=8 ;;
    1) base=8; other=0 ;;
    *) exit 0 ;;
esac
. /usr/share/ModemManager/modemmanager.common
mkdir -m 0755 -p "$MODEMMANAGER_RUNDIR" || exit 1
for port in /sys/class/wwan/wwan*at*; do
    [ -e "$port" ] || continue
    physical=$(readlink -f "$port")
    # Do not claim external USB/PCIe WWAN devices or another serial channel.
    case "$physical" in /sys/devices/platform/sipc-virt/*/wwan/*/*) ;; *) continue ;; esac
    mm_report_event add "${port##*/}" wwan "$physical"
    # Stock getEthIndexBySocketId: cid-1 for SIM1, cid+7 for SIM2.
    # Withdraw the whole other bank before publishing this card's contexts.
    index=$other
    while [ "$index" -lt "$((other + 8))" ]; do
        interface=sipa_eth$index
        if grep -q "^add,$interface,net," "$MODEMMANAGER_EVENTS_CACHE" 2>/dev/null; then
            mm_report_event remove "$interface" net "/sys/devices/virtual/net/$interface"
        fi
        index=$((index + 1))
    done
    index=$base
    while [ "$index" -lt "$((base + 8))" ]; do
        interface=sipa_eth$index
        if [ -e "/sys/class/net/$interface" ]; then
            mm_report_event add "$interface" net "/sys/devices/virtual/net/$interface"
        fi
        index=$((index + 1))
    done
done
