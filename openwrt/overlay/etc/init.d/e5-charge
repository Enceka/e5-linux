#!/bin/sh /etc/rc.common
# Charge control: the upper limit, the resume level, charge to full once
# (/usr/libexec/e5-charge, /etc/config/e5-charge).  A settings change applies
# at once: the service is restarted by its reload trigger.
START=85
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/e5-charge
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

# a settings change applies now, not at the loop's next look
reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger e5-charge
}
