+/* Dual-standby voice. Query both addressed CLCC storages, then hand the full
+ * list to the existing ModemManager call tracker. URC channels are hints:
+ * CNMI/voice setup can route either card's indications onto the primary ring. */
+typedef struct {
+    guint slot;
+    guint own;
+    gint64 started_at;
+    GList *calls;
+    GError *error;
+} VoiceListContext;
+
+static void voice_list_free (VoiceListContext *ctx)
+{
+    mm_3gpp_call_info_list_free (ctx->calls);
+    g_clear_error (&ctx->error);
+    g_free (ctx);
+}
+static gboolean voice_load_finish (MMIfaceModemVoice *self, GAsyncResult *res,
+                                   GList **list, GError **error)
