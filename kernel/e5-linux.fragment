# e5-linux: general-purpose Linux (Ubuntu/systemd) additions for the Rongyue E5
# (Unisoc UMS9621 / qogirn6lite / ums9158_1h10), merged on top of the device's
# Android defconfig arch/arm64/configs/e5_rongyue_defconfig.
#
# The base defconfig already carries everything the *Android* boot needs
# (CGROUPS, MODULES, BLK_DEV_LOOP, USB_CONFIGFS, EXT4_FS, F2FS_FS, OVERLAY_FS,
# TMPFS, PSTORE/PSTORE_RAM/PSTORE_PMSG/PSTORE_CONSOLE, USB_GADGET,
# USB_MUSB_HDRC=m, USB_MUSB_SPRD=m, PM_WAKELOCKS=y, SERIAL_AMBA_PL011).
# Only what a Linux userspace additionally needs is listed here.

# --- devtmpfs: the initramfs cannot populate /dev without it
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- configfs: the initramfs builds its own USB gadget (ECM + ACM) through it
CONFIG_CONFIGFS_FS=y

# --- USB gadget: ECM network + CDC-ACM console, built in so the console does not
#     depend on module load order. musb itself stays a module (stock order).
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_F_ECM=y
CONFIG_USB_F_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ACM=y

# --- Android restricts usermode helpers to one static binary; Linux needs
#     /proc/sys/kernel/hotplug and the firmware loader
# CONFIG_STATIC_USERMODEHELPER is not set
CONFIG_UEVENT_HELPER=y
CONFIG_UEVENT_HELPER_PATH=""
CONFIG_FW_LOADER_USER_HELPER=y

# --- systemd prerequisites missing from the Android defconfig
CONFIG_FHANDLE=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUTOFS_FS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_BPF=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_NAMESPACES=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_KCMP=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_AIO=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SYSVIPC=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_RT_GROUP_SCHED=y

# --- kernel-image handling for the Linux rootfs (kmod, initramfs tools)
CONFIG_MODULE_COMPRESS_NONE=y
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_MODULE_UNLOAD=y

# --- networking: nftables/NAT for USB tethering, plus the usual stack
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_BRIDGE=y
CONFIG_NF_TABLES_SET=y
CONFIG_NFT_CT=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_HASH=y
CONFIG_NFT_CONNLIMIT=y
CONFIG_NFT_SOCKET=y
CONFIG_NFT_TPROXY=y
CONFIG_NFT_FLOW_OFFLOAD=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_NETDEV=y
CONFIG_NFT_FWD_NETDEV=y
CONFIG_NFT_BRIDGE_META=y
CONFIG_NFT_BRIDGE_REJECT=y
CONFIG_NF_FLOW_TABLE=y
CONFIG_NF_FLOW_TABLE_INET=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VLAN_8021Q=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_VXLAN=y
CONFIG_TUN=y
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_PACKET_DIAG=y
CONFIG_UNIX_DIAG=y
CONFIG_INET_DIAG=y

# --- storage / filesystems a distribution expects
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_BTRFS_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_ISO9660_FS=y
CONFIG_UDF_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
CONFIG_MSDOS_FS=y
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y
CONFIG_NFS_FS=m
CONFIG_NFS_V4=m
CONFIG_CIFS=m

# --- swap / memory (the E5 has 4 GiB of RAM; zram is the usual escape hatch)
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_ZSWAP=y
CONFIG_FRONTSWAP=y
CONFIG_CLEANCACHE=y
CONFIG_SWAP=y

# --- crypto user APIs (cryptsetup, TLS, iwd)
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_AEAD=y
CONFIG_CRYPTO_USER_API_RNG=y
CONFIG_TLS=y
CONFIG_DM_CRYPT=y
CONFIG_DM_VERITY=y

# --- userspace hardware access
CONFIG_I2C_CHARDEV=y
CONFIG_SPI_SPIDEV=y
CONFIG_GPIO_SYSFS=y
CONFIG_HWMON=y
CONFIG_THERMAL=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_IDLE=y

# --- USB host devices (serial adapters, ethernet, storage, audio)
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_OPTION=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_STORAGE=m
CONFIG_USB_HID=y
CONFIG_USB_ACM=y

# --- pixel/console output on the internal MIPI panel (best effort; the panel
#     driver comes from the stock DT)
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_LEGACY_PTYS=y

# --- build speed: no DWARF/BTF for a bring-up kernel (kallsyms still gives
#     symbol names in oops/panic output)
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_BTF is not set

# --- SELinux stays built in (the vendor tree expects it) but is disabled from
#     the kernel command line; no policy is shipped in the Linux rootfs
CONFIG_DEFAULT_SECURITY_DAC=y
