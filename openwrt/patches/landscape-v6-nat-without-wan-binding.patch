@@ -0,0 +1,113 @@
+//! Regression tests for an uplink that has no IPv6 address bound in
+//! `wan_ip_binding` (for example a carrier link that only got a v4 address, or
+//! an uplink whose IPv6 binding has not been published yet).
+//!
+//! The NAT stage must not black-hole IPv6 on such a link: there is no WAN
+//! prefix to translate to, so it has nothing to do and must hand the packet
+//! back to the kernel.  Returning `TC_ACT_SHOT` here dropped every IPv6 packet
+//! on the interface, including router-originated RS/RA and DHCPv6 traffic.
+
+use std::{mem::MaybeUninit, net::Ipv6Addr, str::FromStr};
+
+use etherparse::PacketBuilder;
+use libbpf_rs::{
+    ProgramInput,
+    skel::{OpenSkel, SkelBuilder as _},
+};
+use zerocopy::IntoBytes;
+
+use crate::{stages::nat::tc_nat_skel::TcNatSkelBuilder, tests::TestSkb};
+
+// Loopback: `test_run` needs a real netdev, and this path never looks at the
+// device itself — only at the absence of a `wan_ip_binding` row.
+const IFINDEX: u32 = 1;
+const CLIENT_PORT: u16 = 40000;
+
+fn lan_host() -> Ipv6Addr {
+    Ipv6Addr::from_str("fd00:1234:5678:abc5::100").unwrap()
+}
+
+fn remote() -> Ipv6Addr {
+    Ipv6Addr::from_str("2400:3200::1").unwrap()
+}
+
+fn build_ipv6_tcp(src: Ipv6Addr, dst: Ipv6Addr, src_port: u16, dst_port: u16) -> Vec<u8> {
+    let builder = PacketBuilder::ethernet2(
+        [0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF],
+        [0x11, 0x22, 0x33, 0x44, 0x55, 0x66],
+    )
+    .ipv6(src.octets(), dst.octets(), 64)
+    .tcp(src_port, dst_port, 1, 1000);
+
+    let payload = [0u8; 8];
+    let mut buf = Vec::with_capacity(builder.size(payload.len()));
+    builder.write(&mut buf, &payload).unwrap();
+    buf
+}
+
+fn run_egress(pkt: &[u8]) -> (i32, Vec<u8>) {
+    let mut builder = TcNatSkelBuilder::default();
+    let pin_root = crate::tests::isolated_pin_root("nat-v6-no-wan-binding");
+    builder.object_builder_mut().pin_root_path(&pin_root).unwrap();
+    let mut open_object = MaybeUninit::uninit();
+    let open_skel = builder.open(&mut open_object).unwrap();
+    let skel = open_skel.load().unwrap();
+
+    // Deliberately no add_wan_ip(): the uplink has no IPv6 binding at all.
+    let mut ctx = TestSkb { ifindex: IFINDEX, ..Default::default() };
+    let mut packet_out = vec![0u8; pkt.len()];
+    let input = ProgramInput {
+        data_in: Some(pkt),
+        context_in: Some(ctx.as_mut_bytes()),
+        data_out: Some(&mut packet_out),
+        ..Default::default()
+    };
+
+    let result = skel.progs.tc_nat_wan_egress.test_run(input).expect("test_run failed");
+    (result.return_value as i32, packet_out)
+}
+
+fn run_ingress(pkt: &[u8]) -> (i32, Vec<u8>) {
+    let mut builder = TcNatSkelBuilder::default();
+    let pin_root = crate::tests::isolated_pin_root("nat-v6-no-wan-binding-ingress");
+    builder.object_builder_mut().pin_root_path(&pin_root).unwrap();
+    let mut open_object = MaybeUninit::uninit();
+    let open_skel = builder.open(&mut open_object).unwrap();
+    let skel = open_skel.load().unwrap();
+
+    let mut ctx = TestSkb { ifindex: IFINDEX, ..Default::default() };
+    let mut packet_out = vec![0u8; pkt.len()];
+    let input = ProgramInput {
+        data_in: Some(pkt),
+        context_in: Some(ctx.as_mut_bytes()),
+        data_out: Some(&mut packet_out),
+        ..Default::default()
+    };
+
+    let result = skel.progs.tc_nat_wan_ingress.test_run(input).expect("test_run failed");
+    (result.return_value as i32, packet_out)
+}
+
+#[test]
+fn v6_egress_without_wan_binding_passes_to_kernel_route() {
+    let pkt = build_ipv6_tcp(lan_host(), remote(), CLIENT_PORT, 443);
+    let (ret, out) = run_egress(&pkt);
+
+    assert_eq!(
+        ret, -1,
+        "no IPv6 binding on the uplink means NAT has nothing to do: TC_ACT_UNSPEC(-1), not TC_ACT_SHOT(-2)"
+    );
+    assert_eq!(out, pkt, "the packet must not be rewritten when there is no WAN prefix");
+}
+
+#[test]
+fn v6_ingress_without_wan_binding_passes_to_kernel_route() {
+    let pkt = build_ipv6_tcp(remote(), lan_host(), 443, CLIENT_PORT);
+    let (ret, out) = run_ingress(&pkt);
+
+    assert_eq!(
+        ret, 0,
+        "no IPv6 binding on the uplink means NAT has nothing to do: TC_ACT_OK(0), not TC_ACT_SHOT(-2)"
+    );
+    assert_eq!(out, pkt, "the packet must not be rewritten when there is no WAN prefix");
+}
