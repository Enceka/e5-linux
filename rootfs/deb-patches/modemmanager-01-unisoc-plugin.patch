diff -ruN a/src/plugins/unisoc/77-mm-unisoc-sipc.rules b/src/plugins/unisoc/77-mm-unisoc-sipc.rules
--- a/src/plugins/unisoc/77-mm-unisoc-sipc.rules	1970-01-01 08:00:00
+++ b/src/plugins/unisoc/77-mm-unisoc-sipc.rules	2026-09-26 16:53:09
@@ -0,0 +1,12 @@
+# do not edit this file, it will be overwritten on update
+
+# Unisoc (Spreadtrum) SoC modems reached over SIPC: the AT port is the WWAN
+# port the kernel's sipc_wwan driver registers on the sprd,spipe AT channel,
+# the data path the sipa_eth interface of the first PDP context.  Tag both for
+# the unisoc plugin and group them into one modem.
+ACTION!="add|change|move|bind", GOTO="mm_unisoc_sipc_end"
+
+SUBSYSTEM=="wwan", DRIVERS=="sprd-spipe", ENV{ID_MM_UNISOC_SIPC}="1", ENV{ID_MM_PHYSDEV_UID}="unisoc-sipc", ENV{ID_MM_PORT_TYPE_AT_PRIMARY}="1"
+SUBSYSTEM=="net", KERNEL=="sipa_eth0", ENV{ID_MM_UNISOC_SIPC}="1", ENV{ID_MM_PHYSDEV_UID}="unisoc-sipc"
+
+LABEL="mm_unisoc_sipc_end"
diff -ruN a/src/plugins/unisoc/mm-broadband-bearer-unisoc.c b/src/plugins/unisoc/mm-broadband-bearer-unisoc.c
--- a/src/plugins/unisoc/mm-broadband-bearer-unisoc.c	1970-01-01 08:00:00
+++ b/src/plugins/unisoc/mm-broadband-bearer-unisoc.c	2026-09-26 18:38:53
@@ -0,0 +1,562 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * Data bearer of the Unisoc SIPC modems.  The PDP context is selected and
+ * defined by the generic code (+CGDCONT); then
+ *
+ *   AT+CGACT=1,<cid>              activate it
+ *   AT+CGDATA="M-ETHER",<cid>     route it to the SIPA network interface
+ *                                 (answers CONNECT; the AT port stays in
+ *                                 command mode)
+ *   AT+CGCONTRDP=<cid>            the IPv4 settings, which the interface does
+ *                                 not learn by DHCP: static configuration.
+ *                                 IPv6 comes by router advertisement, with
+ *                                 the interface identifier given here.
+ *
+ * and AT+CGACT=0,<cid> to disconnect.  The CP routes context <cid> to the
+ * SIPA interface of net id <cid> - 1, i.e. sipa_eth<cid - 1>: context 1 is
+ * sipa_eth0, the one interface the E5 hands to ModemManager.  (Another
+ * context's traffic does not come out of sipa_eth0 -- measured: context 12,
+ * which the generic profile selection once picked, left sipa_eth0 silent.)
+ */
+
+#include <config.h>
+
+#include <stdlib.h>
+#include <string.h>
+
+#include <gio/gio.h>
+
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "ModemManager.h"
+#include "mm-base-modem-at.h"
+#include "mm-broadband-bearer-unisoc.h"
+#include "mm-log-object.h"
+#include "mm-modem-helpers.h"
+
+G_DEFINE_TYPE (MMBroadbandBearerUnisoc, mm_broadband_bearer_unisoc, MM_TYPE_BROADBAND_BEARER)
+
+typedef struct {
+    MMBaseModem    *modem;
+    MMPortSerialAt *primary;
+    MMPort         *data;
+    guint           cid;
+    MMBearerIpFamily ip_family;
+} CommonContext;
+
+static void
+common_context_free (CommonContext *ctx)
+{
+    g_clear_object (&ctx->modem);
+    g_clear_object (&ctx->primary);
+    g_clear_object (&ctx->data);
+    g_slice_free (CommonContext, ctx);
+}
+
+static GTask *
+common_task_new (MMBroadbandBearerUnisoc *self,
+                 MMBaseModem             *modem,
+                 MMPortSerialAt          *primary,
+                 MMPort                  *data,
+                 guint                    cid,
+                 GCancellable            *cancellable,
+                 GAsyncReadyCallback      callback,
+                 gpointer                 user_data)
+{
+    CommonContext *ctx;
+    GTask         *task;
+
+    task = g_task_new (self, cancellable, callback, user_data);
+    ctx = g_slice_new0 (CommonContext);
+    ctx->modem = g_object_ref (modem);
+    ctx->primary = g_object_ref (primary);
+    ctx->cid = cid;
+    if (data)
+        ctx->data = g_object_ref (data);
+    else {
+        g_autofree gchar *name = NULL;
+
+        name = g_strdup_printf ("sipa_eth%u", cid ? cid - 1 : 0);
+        ctx->data = mm_base_modem_get_port (modem, name);
+        if (ctx->data && mm_port_get_port_type (ctx->data) != MM_PORT_TYPE_NET)
+            g_clear_object (&ctx->data);
+    }
+    g_task_set_task_data (task, ctx, (GDestroyNotify) common_context_free);
+
+    if (!ctx->data) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_NOT_FOUND,
+                                 "No network interface for PDP context %u (sipa_eth%u)",
+                                 cid, cid ? cid - 1 : 0);
+        g_object_unref (task);
+        return NULL;
+    }
+    return task;
+}
+
+/*****************************************************************************/
+/* Dial (sub-step of the 3GPP connection sequence) */
+
+static MMPort *
+dial_3gpp_finish (MMBroadbandBearer  *self,
+                  GAsyncResult       *res,
+                  GError            **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void
+cgdata_ready (MMBaseModem  *modem,
+              GAsyncResult *res,
+              GTask        *task)
+{
+    CommonContext *ctx = g_task_get_task_data (task);
+    GError        *error = NULL;
+
+    if (!mm_base_modem_at_command_full_finish (modem, res, &error)) {
+        g_prefix_error (&error, "Couldn't route the PDP context to %s: ",
+                        mm_port_get_device (ctx->data));
+        g_task_return_error (task, error);
+    } else
+        g_task_return_pointer (task, g_object_ref (ctx->data), g_object_unref);
+    g_object_unref (task);
+}
+
+static void
+cgact_ready (MMBaseModem  *modem,
+             GAsyncResult *res,
+             GTask        *task)
+{
+    CommonContext    *ctx = g_task_get_task_data (task);
+    GError           *error = NULL;
+    g_autofree gchar *cmd = NULL;
+
+    if (!mm_base_modem_at_command_full_finish (modem, res, &error)) {
+        g_prefix_error (&error, "Couldn't activate PDP context %u: ", ctx->cid);
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    cmd = g_strdup_printf ("+CGDATA=\"M-ETHER\",%u", ctx->cid);
+    mm_base_modem_at_command_full (ctx->modem,
+                                   MM_IFACE_PORT_AT (ctx->primary),
+                                   cmd,
+                                   30,
+                                   FALSE, /* allow_cached */
+                                   FALSE, /* is_raw */
+                                   g_task_get_cancellable (task),
+                                   (GAsyncReadyCallback) cgdata_ready,
+                                   task);
+}
+
+static void
+dial_3gpp (MMBroadbandBearer   *self,
+           MMBaseModem         *modem,
+           MMPortSerialAt      *primary,
+           guint                cid,
+           GCancellable        *cancellable,
+           GAsyncReadyCallback  callback,
+           gpointer             user_data)
+{
+    GTask            *task;
+    g_autofree gchar *cmd = NULL;
+
+    task = common_task_new (MM_BROADBAND_BEARER_UNISOC (self), modem, primary, NULL, cid,
+                            cancellable, callback, user_data);
+    if (!task)
+        return;
+
+    cmd = g_strdup_printf ("+CGACT=1,%u", cid);
+    mm_base_modem_at_command_full (modem,
+                                   MM_IFACE_PORT_AT (primary),
+                                   cmd,
+                                   60,
+                                   FALSE, /* allow_cached */
+                                   FALSE, /* is_raw */
+                                   cancellable,
+                                   (GAsyncReadyCallback) cgact_ready,
+                                   task);
+}
+
+/*****************************************************************************/
+/* IP config (sub-step of the 3GPP connection sequence) */
+
+static gboolean
+get_ip_config_3gpp_finish (MMBroadbandBearer  *self,
+                           GAsyncResult       *res,
+                           MMBearerIpConfig  **ipv4_config,
+                           MMBearerIpConfig  **ipv6_config,
+                           GError            **error)
+{
+    MMBearerConnectResult *result;
+    MMBearerIpConfig      *ipv4;
+    MMBearerIpConfig      *ipv6;
+
+    result = g_task_propagate_pointer (G_TASK (res), error);
+    if (!result)
+        return FALSE;
+
+    ipv4 = mm_bearer_connect_result_peek_ipv4_config (result);
+    ipv6 = mm_bearer_connect_result_peek_ipv6_config (result);
+    if (ipv4_config)
+        *ipv4_config = ipv4 ? g_object_ref (ipv4) : NULL;
+    if (ipv6_config)
+        *ipv6_config = ipv6 ? g_object_ref (ipv6) : NULL;
+    mm_bearer_connect_result_unref (result);
+    return TRUE;
+}
+
+static guint
+count_dots (const gchar *s)
+{
+    guint n = 0;
+
+    for (; *s; s++)
+        n += (*s == '.');
+    return n;
+}
+
+/* An IPv6 address as +CGCONTRDP gives it: sixteen dotted bytes (or already
+ * colon-separated) */
+static gchar *
+cgcontrdp_ipv6 (const gchar *str)
+{
+    g_autoptr(GInetAddress) addr = NULL;
+    g_auto(GStrv)           b = NULL;
+    guint8                  bytes[16];
+    guint                   i;
+
+    if (!str || !*str)
+        return NULL;
+    if (strchr (str, ':'))
+        return g_strdup (str);
+    b = g_strsplit (str, ".", -1);
+    if (g_strv_length (b) < 16)
+        return NULL;
+    for (i = 0; i < 16; i++)
+        bytes[i] = (guint8) atoi (b[i]);
+    addr = g_inet_address_new_from_bytes (bytes, G_SOCKET_FAMILY_IPV6);
+    return g_inet_address_to_string (addr);
+}
+
+typedef struct {
+    gchar *address;
+    gchar *subnet;
+    gchar *gateway;
+    gchar *dns[3];
+} CgcontrdpIpv4;
+
+typedef struct {
+    gchar *link_local;
+    gchar *dns[3];
+} CgcontrdpIpv6;
+
+static void
+cgcontrdp_clear (CgcontrdpIpv4 *v4,
+                 CgcontrdpIpv6 *v6)
+{
+    g_free (v4->address);
+    g_free (v4->subnet);
+    g_free (v4->gateway);
+    g_free (v4->dns[0]);
+    g_free (v4->dns[1]);
+    g_free (v6->link_local);
+    g_free (v6->dns[0]);
+    g_free (v6->dns[1]);
+}
+
+/* The link-local address from the interface identifier the network assigned:
+ * the lower half of the IPv6 line's address, whose upper half is zero (the
+ * /64 comes by router advertisement).  The parser split the dotted field after
+ * its fourth byte, so the halves are put back together first. */
+static gchar *
+cgcontrdp_link_local (const gchar *head,
+                      const gchar *tail)
+{
+    g_autofree gchar        *joined = NULL;
+    g_auto(GStrv)            b = NULL;
+    g_autoptr(GInetAddress)  addr = NULL;
+    guint8                   bytes[16] = { 0xfe, 0x80 };
+    gboolean                 nonzero = FALSE;
+    guint                    i;
+
+    joined = g_strjoin (".", head, tail ? tail : "", NULL);
+    b = g_strsplit (joined, ".", -1);
+    if (g_strv_length (b) < 16)
+        return NULL;
+    for (i = 8; i < 16; i++) {
+        bytes[i] = (guint8) atoi (b[i]);
+        nonzero |= !!bytes[i];
+    }
+    if (!nonzero)
+        return NULL;
+    addr = g_inet_address_new_from_bytes (bytes, G_SOCKET_FAMILY_IPV6);
+    return g_inet_address_to_string (addr);
+}
+
+/* One +CGCONTRDP line per address family.  An IPv6 line may be dotted
+ * decimal too, 16 bytes of address and 16 of mask: an IPv4 mask has four. */
+static void
+parse_cgcontrdp (const gchar   *response,
+                 gboolean      *have_v4,
+                 CgcontrdpIpv4 *v4,
+                 gboolean      *have_v6,
+                 CgcontrdpIpv6 *v6)
+{
+    g_auto(GStrv) lines = NULL;
+    guint         i;
+
+    *have_v4 = *have_v6 = FALSE;
+    lines = g_strsplit_set (response, "\r\n", -1);
+    for (i = 0; lines[i]; i++) {
+        g_autofree gchar *a = NULL;
+        g_autofree gchar *m = NULL;
+        g_autofree gchar *g = NULL;
+        g_autofree gchar *d1 = NULL;
+        g_autofree gchar *d2 = NULL;
+
+        if (!g_str_has_prefix (lines[i], "+CGCONTRDP:") ||
+            !mm_3gpp_parse_cgcontrdp_response (lines[i], NULL, NULL, NULL,
+                                               &a, &m, &g, &d1, &d2, NULL) ||
+            !a)
+            continue;
+        if (!*have_v4 && !strchr (a, ':') && (!m || count_dots (m) == 3)) {
+            *have_v4 = TRUE;
+            v4->address = g_steal_pointer (&a);
+            v4->subnet = g_steal_pointer (&m);
+            v4->gateway = g_steal_pointer (&g);
+            v4->dns[0] = g_steal_pointer (&d1);
+            v4->dns[1] = g_steal_pointer (&d2);
+        } else if (!*have_v6) {
+            *have_v6 = TRUE;
+            if (!strchr (a, ':'))
+                v6->link_local = cgcontrdp_link_local (a, m);
+            v6->dns[0] = cgcontrdp_ipv6 (d1);
+            v6->dns[1] = cgcontrdp_ipv6 (d2);
+            if (!v6->dns[0]) {
+                v6->dns[0] = v6->dns[1];
+                v6->dns[1] = NULL;
+            }
+        }
+    }
+}
+
+static void
+cgcontrdp_ready (MMBaseModem  *modem,
+                 GAsyncResult *res,
+                 GTask        *task)
+{
+    MMBroadbandBearerUnisoc    *self = g_task_get_source_object (task);
+    CommonContext              *ctx = g_task_get_task_data (task);
+    const gchar                *response;
+    GError                     *error = NULL;
+    gboolean                    want_ipv4;
+    gboolean                    want_ipv6;
+    gboolean                    have_v4;
+    gboolean                    have_v6;
+    CgcontrdpIpv4               v4 = { 0 };
+    CgcontrdpIpv6               v6 = { 0 };
+    g_autoptr(MMBearerIpConfig) ipv4 = NULL;
+    g_autoptr(MMBearerIpConfig) ipv6 = NULL;
+
+    want_ipv4 = !!(ctx->ip_family & (MM_BEARER_IP_FAMILY_IPV4 | MM_BEARER_IP_FAMILY_IPV4V6));
+    want_ipv6 = !!(ctx->ip_family & (MM_BEARER_IP_FAMILY_IPV6 | MM_BEARER_IP_FAMILY_IPV4V6));
+
+    response = mm_base_modem_at_command_full_finish (modem, res, &error);
+    if (!response) {
+        g_prefix_error (&error, "Couldn't read the settings of PDP context %u: ", ctx->cid);
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+    parse_cgcontrdp (response, &have_v4, &v4, &have_v6, &v6);
+    /* an IPv4v6 context the network granted only IPv6 goes on without IPv4 */
+    if (want_ipv4 && !have_v4 && !(want_ipv6 && have_v6)) {
+        cgcontrdp_clear (&v4, &v6);
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "No IPv4 settings for PDP context %u", ctx->cid);
+        g_object_unref (task);
+        return;
+    }
+
+    if (want_ipv4 && have_v4) {
+        ipv4 = mm_bearer_ip_config_new ();
+        mm_bearer_ip_config_set_method (ipv4, MM_BEARER_IP_METHOD_STATIC);
+        mm_bearer_ip_config_set_address (ipv4, v4.address);
+        if (v4.subnet)
+            mm_bearer_ip_config_set_prefix (ipv4, mm_netmask_to_cidr (v4.subnet));
+        /* no gateway: the default route goes straight out of the interface */
+        if (v4.gateway && *v4.gateway && g_strcmp0 (v4.gateway, "0.0.0.0") != 0)
+            mm_bearer_ip_config_set_gateway (ipv4, v4.gateway);
+        mm_bearer_ip_config_set_dns (ipv4, (const gchar **) v4.dns);
+        mm_obj_dbg (self, "PDP context %u: %s/%s, dns %s %s", ctx->cid, v4.address,
+                    v4.subnet ? v4.subnet : "?",
+                    v4.dns[0] ? v4.dns[0] : "-", v4.dns[1] ? v4.dns[1] : "-");
+    }
+    /* the interface learns its IPv6 address by router advertisement */
+    if (want_ipv6) {
+        ipv6 = mm_bearer_ip_config_new ();
+        mm_bearer_ip_config_set_method (ipv6, MM_BEARER_IP_METHOD_DHCP);
+        /* a link-local address hands NetworkManager the interface identifier
+         * for SLAAC; sipa_eth0 has no MAC address to derive one from */
+        if (have_v6 && v6.link_local) {
+            mm_bearer_ip_config_set_address (ipv6, v6.link_local);
+            mm_bearer_ip_config_set_prefix (ipv6, 64);
+        }
+        if (have_v6 && v6.dns[0]) {
+            mm_bearer_ip_config_set_dns (ipv6, (const gchar **) v6.dns);
+            mm_obj_dbg (self, "PDP context %u: IPv6 dns %s %s", ctx->cid,
+                        v6.dns[0], v6.dns[1] ? v6.dns[1] : "-");
+        }
+    }
+    cgcontrdp_clear (&v4, &v6);
+
+    g_task_return_pointer (task, mm_bearer_connect_result_new (ctx->data, ipv4, ipv6),
+                           (GDestroyNotify) mm_bearer_connect_result_unref);
+    g_object_unref (task);
+}
+
+static void
+get_ip_config_3gpp (MMBroadbandBearer   *self,
+                    MMBroadbandModem    *modem,
+                    MMPortSerialAt      *primary,
+                    MMPortSerialAt      *secondary,
+                    MMPort              *data,
+                    guint                cid,
+                    MMBearerIpFamily     ip_family,
+                    GAsyncReadyCallback  callback,
+                    gpointer             user_data)
+{
+    GTask            *task;
+    CommonContext    *ctx;
+    g_autofree gchar *cmd = NULL;
+
+    task = common_task_new (MM_BROADBAND_BEARER_UNISOC (self), MM_BASE_MODEM (modem),
+                            primary, data, cid, NULL, callback, user_data);
+    if (!task)
+        return;
+    ctx = g_task_get_task_data (task);
+    ctx->ip_family = ip_family;
+
+    cmd = g_strdup_printf ("+CGCONTRDP=%u", cid);
+    mm_base_modem_at_command_full (MM_BASE_MODEM (modem),
+                                   MM_IFACE_PORT_AT (primary),
+                                   cmd,
+                                   10,
+                                   FALSE, /* allow_cached */
+                                   FALSE, /* is_raw */
+                                   NULL,
+                                   (GAsyncReadyCallback) cgcontrdp_ready,
+                                   task);
+}
+
+/*****************************************************************************/
+/* Disconnect */
+
+static gboolean
+disconnect_3gpp_finish (MMBroadbandBearer  *self,
+                        GAsyncResult       *res,
+                        GError            **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+cgact_disconnect_ready (MMBaseModem  *modem,
+                        GAsyncResult *res,
+                        GTask        *task)
+{
+    GError *error = NULL;
+
+    if (!mm_base_modem_at_command_full_finish (modem, res, &error))
+        g_task_return_error (task, error);
+    else
+        g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+disconnect_3gpp (MMBroadbandBearer   *self,
+                 MMBroadbandModem    *modem,
+                 MMPortSerialAt      *primary,
+                 MMPortSerialAt      *secondary,
+                 MMPort              *data,
+                 guint                cid,
+                 GAsyncReadyCallback  callback,
+                 gpointer             user_data)
+{
+    GTask            *task;
+    g_autofree gchar *cmd = NULL;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    cmd = cid ? g_strdup_printf ("+CGACT=0,%u", cid) : g_strdup ("+CGACT=0");
+    mm_base_modem_at_command_full (MM_BASE_MODEM (modem),
+                                   MM_IFACE_PORT_AT (primary),
+                                   cmd,
+                                   45,
+                                   FALSE, /* allow_cached */
+                                   FALSE, /* is_raw */
+                                   NULL,
+                                   (GAsyncReadyCallback) cgact_disconnect_ready,
+                                   task);
+}
+
+/*****************************************************************************/
+
+MMBaseBearer *
+mm_broadband_bearer_unisoc_new_finish (GAsyncResult  *res,
+                                       GError       **error)
+{
+    GObject *source;
+    GObject *bearer;
+
+    source = g_async_result_get_source_object (res);
+    bearer = g_async_initable_new_finish (G_ASYNC_INITABLE (source), res, error);
+    g_object_unref (source);
+    if (!bearer)
+        return NULL;
+
+    mm_base_bearer_export (MM_BASE_BEARER (bearer));
+    return MM_BASE_BEARER (bearer);
+}
+
+void
+mm_broadband_bearer_unisoc_new (MMBroadbandModemUnisoc *modem,
+                                MMBearerProperties     *config,
+                                GCancellable           *cancellable,
+                                GAsyncReadyCallback     callback,
+                                gpointer                user_data)
+{
+    g_async_initable_new_async (MM_TYPE_BROADBAND_BEARER_UNISOC,
+                                G_PRIORITY_DEFAULT,
+                                cancellable,
+                                callback,
+                                user_data,
+                                MM_BASE_BEARER_MODEM,  modem,
+                                MM_BASE_BEARER_CONFIG, config,
+                                NULL);
+}
+
+static void
+mm_broadband_bearer_unisoc_init (MMBroadbandBearerUnisoc *self)
+{
+}
+
+static void
+mm_broadband_bearer_unisoc_class_init (MMBroadbandBearerUnisocClass *klass)
+{
+    MMBroadbandBearerClass *broadband_bearer_class = MM_BROADBAND_BEARER_CLASS (klass);
+
+    broadband_bearer_class->dial_3gpp = dial_3gpp;
+    broadband_bearer_class->dial_3gpp_finish = dial_3gpp_finish;
+    broadband_bearer_class->get_ip_config_3gpp = get_ip_config_3gpp;
+    broadband_bearer_class->get_ip_config_3gpp_finish = get_ip_config_3gpp_finish;
+    broadband_bearer_class->disconnect_3gpp = disconnect_3gpp;
+    broadband_bearer_class->disconnect_3gpp_finish = disconnect_3gpp_finish;
+}
