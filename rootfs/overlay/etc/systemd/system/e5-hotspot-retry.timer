[Unit]
# The WCN chip refuses to power on often enough that e5-hotspot can come out of a
# boot with no AP at all, and the unit is a oneshot, so nothing retries it.  The
# timer is a convenience, not a prohibition: restarting the hotspot by hand is a
# normal thing to do.  (The USB link looked like it vanished around one such
# restart, but the address on the host side had just been switched from a hand-set
# one to DHCP at the same time -- that alone is enough to lose the path.)
#
# The timer re-runs the hotspot service every ten minutes.  The service is a
# no-op when hostapd is already up, so the only cost once it works is a pgrep.
Description=E5 Wi-Fi hotspot retry (WCN power-on is flaky at boot)
After=e5-vendor.service

[Timer]
OnBootSec=3min
OnUnitActiveSec=10min
Unit=e5-hotspot.service
Persistent=false

[Install]
WantedBy=timers.target
