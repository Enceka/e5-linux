[Unit]
# ADB over USB on the Linux side: adds ffs.adb to the E5's gadget and runs the Debian
# adbd.  See docs/FINDINGS.md section 21 for the two traps (VID/PID only before binding,
# and the package's own gadget helper wanting the UDC for itself).
Description=E5 ADB gadget and adbd
After=sysinit.target
ConditionPathExists=/sys/kernel/config/usb_gadget/linux

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/e5/adbd-gadget.sh
ExecStop=/usr/bin/pkill -f platform-tools/adbd
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
