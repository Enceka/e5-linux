-static void
-cards_on (MMBaseModem         *self,
-          GAsyncReadyCallback  callback,
-          gpointer             user_data)
-{
-    mm_base_modem_at_command (self, "+SPTESTMODE?", 5, FALSE,
-                              (GAsyncReadyCallback) cards_on_testmode_ready,
-                              g_task_new (self, NULL, callback, user_data));
+static void cards_on_probe_next (GTask *task);
+static void
+cards_on_probe_ready (MMBaseModem *self, GAsyncResult *res, GTask *task)
+{
+    CardsOnContext *ctx = g_task_get_task_data (task);
+    GError *error = NULL;
+    mm_base_modem_at_command_finish (self, res, &error);
+    if (error && g_error_matches (error, MM_MOBILE_EQUIPMENT_ERROR, MM_MOBILE_EQUIPMENT_ERROR_SIM_NOT_INSERTED))
+        ctx->present[ctx->probe] = FALSE;
+    g_clear_error (&error);
+    ctx->probe++;
+    cards_on_probe_next (task);
+}
+static void
+cards_on_probe_next (GTask *task)
+{
+    MMBaseModem *self = g_task_get_source_object (task);
+    CardsOnContext *ctx = g_task_get_task_data (task);
+    gchar *command;
+    if (ctx->probe < 2) {
+        command = g_strdup_printf ("+SPACTCARD=%u;+CPIN?", ctx->probe);
+        mm_base_modem_at_command (self, command, 5, FALSE, (GAsyncReadyCallback)cards_on_probe_ready, task);
+    } else {
+        command = g_strdup_printf ("+SPACTCARD=%u;+SPTESTMODE?", ctx->own);
+        mm_base_modem_at_command (self, command, 5, FALSE, (GAsyncReadyCallback)cards_on_testmode_ready, task);
+    }
+    g_free (command);
+}
+static void
+cards_on (MMBaseModem *self, GAsyncReadyCallback callback, gpointer user_data)
+{
+    GTask *task = g_task_new (self, NULL, callback, user_data);
+    CardsOnContext *ctx = g_slice_new0 (CardsOnContext);
+    ctx->present[0] = ctx->present[1] = TRUE;
+    ctx->own = port_card ();
+    g_task_set_task_data (task, ctx, (GDestroyNotify)cards_on_context_free);
+    cards_on_probe_next (task);
 }
 
 static gboolean
