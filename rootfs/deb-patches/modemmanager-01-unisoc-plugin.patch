diff -ruN a/src/plugins/unisoc/mm-broadband-modem-unisoc.c b/src/plugins/unisoc/mm-broadband-modem-unisoc.c
--- a/src/plugins/unisoc/mm-broadband-modem-unisoc.c	1970-01-01 08:00:00
+++ b/src/plugins/unisoc/mm-broadband-modem-unisoc.c	2026-09-26 21:39:07
@@ -0,0 +1,1125 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * The generic broadband modem, except:
+ *
+ *  - no ATZ.  The CP's AT server does not answer it and stays silent for
+ *    every client afterwards (seen on a UMS9621); the rest of the generic
+ *    enabling sequence was checked command by command and is harmless.
+ *  - no +CPMS= either, which silences it the same way -- even to select the
+ *    storages it already uses.  SMS work stays in the storages +CPMS?
+ *    reports (SIM, for mem1 to mem3).
+ *  - data goes through a network interface (sipa_eth), with the IP settings
+ *    of +CGCONTRDP: see mm-broadband-bearer-unisoc.c.
+ *  - what the modem does not say about itself: +GCAP reports +CGSM only and
+ *    +WS46=? is not supported, although it is an LTE and NR modem, and
+ *    +CGDCONT=? lists "IP" only although its contexts are IPV4V6.
+ *  - signal from +CESQ, NR fields included; +CSQ answers 255 ("unknown") on
+ *    NR.  The modem also sends +CSQ and +CESQ unsolicited every few seconds:
+ *    +CESQ updates the signal quality, +CSQ is swallowed.  The LTE SINR, which
+ *    +CESQ lacks, and the cell info (serving and neighbour cells) come from
+ *    the vendor engineering-mode query +SPENGMD.
+ *  - SMS submit needs the service centre written once per boot: until
+ *    AT+CSCA="<smsc>",<type> is sent (with the very value +CSCA? reports),
+ *    every +CMGS answers "+CMS ERROR: 313", whoever sends it and however the
+ *    PDU is built.  Done after the SMS format is set up.
+ *  - the dial answers "+CDU: <n>" before its OK, and a VoLTE call reports its
+ *    state with "+CLCCS:"; both are swallowed (calls are followed through the
+ *    +CLCC polling).
+ *  - power.  +CFUN=4 and +CFUN=1 are flight mode and back, with the SIM kept
+ *    on.  +CFUN=0 switches the SIM off, and nothing brings it back within
+ *    that boot (the vendor pair below then answers "not allowed" or nothing),
+ *    so it is never sent.  The CP comes out of modem_control at +CFUN: 0 with
+ *    the SIM off, though, and the vendor RIL's way up from there is AT+SFUN=2
+ *    (SIM on) and AT+SFUN=4 (protocol stack on): done as soon as the port is
+ *    open, before initialization reads the SIM, and by power-up.
+ */
+
+#include <config.h>
+
+#include <stdlib.h>
+#include <string.h>
+
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "ModemManager.h"
+#include "mm-base-modem-at.h"
+#include "mm-iface-modem.h"
+#include "mm-iface-modem-signal.h"
+#include "mm-iface-modem-messaging.h"
+#include "mm-log-object.h"
+#include "mm-broadband-modem-unisoc.h"
+#include "mm-broadband-bearer-unisoc.h"
+
+/*****************************************************************************/
+/* +CESQ, all nine fields (27.007 8.69):
+ *   rxlev,ber,rscp,ecno,rsrq,rsrp,ss_rsrq,ss_rsrp,ss_sinr
+ * The generic parser stops at the LTE ones. */
+
+typedef struct {
+    gdouble lte_rsrq;
+    gdouble lte_rsrp;
+    gdouble lte_sinr;
+    gdouble nr_rsrq;
+    gdouble nr_rsrp;
+    gdouble nr_sinr;
+} Cesq;
+
+#define CESQ_NONE (-G_MAXDOUBLE)
+
+/* The +CESQ handler on the primary port may still take a reply to AT+CESQ out
+ * of the response (when the reply and its OK arrive in separate reads): the
+ * queries fall back to what it left here. */
+typedef struct {
+    Cesq     last_cesq;
+    gboolean have_cesq;
+} MMBroadbandModemUnisocPrivate;
+
+static void iface_modem_init (MMIfaceModemInterface *iface);
+static void iface_modem_signal_init (MMIfaceModemSignalInterface *iface);
+static void iface_modem_messaging_init (MMIfaceModemMessagingInterface *iface);
+
+static MMIfaceModemMessagingInterface *iface_modem_messaging_parent;
+
+G_DEFINE_TYPE_EXTENDED (MMBroadbandModemUnisoc, mm_broadband_modem_unisoc, MM_TYPE_BROADBAND_MODEM, 0,
+                        G_ADD_PRIVATE (MMBroadbandModemUnisoc)
+                        G_IMPLEMENT_INTERFACE (MM_TYPE_IFACE_MODEM, iface_modem_init)
+                        G_IMPLEMENT_INTERFACE (MM_TYPE_IFACE_MODEM_SIGNAL, iface_modem_signal_init)
+                        G_IMPLEMENT_INTERFACE (MM_TYPE_IFACE_MODEM_MESSAGING, iface_modem_messaging_init))
+
+static MMBroadbandModemUnisocPrivate *
+get_private (gpointer self)
+{
+    return mm_broadband_modem_unisoc_get_instance_private (MM_BROADBAND_MODEM_UNISOC (self));
+}
+
+static gboolean
+parse_cesq (const gchar  *str,
+            Cesq         *out,
+            GError      **error)
+{
+    g_auto(GStrv) f = NULL;
+    guint         v[9];
+    guint         i;
+
+    str = strstr (str, "+CESQ:");
+    if (!str) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "No +CESQ response");
+        return FALSE;
+    }
+    f = g_strsplit (str + strlen ("+CESQ:"), ",", -1);
+    if (g_strv_length (f) < 6) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "Short +CESQ response");
+        return FALSE;
+    }
+    for (i = 0; i < G_N_ELEMENTS (v); i++)
+        v[i] = (i < g_strv_length (f)) ? (guint) strtoul (g_strstrip (f[i]), NULL, 10) : 255;
+
+    out->lte_sinr = CESQ_NONE; /* not in +CESQ: from +SPENGMD */
+    out->lte_rsrq = v[4] <= 34  ? -20.0 + v[4] * 0.5 : CESQ_NONE;
+    out->lte_rsrp = v[5] <= 97  ? -141.0 + v[5]      : CESQ_NONE;
+    out->nr_rsrq  = v[6] <= 127 ? -43.0 + v[6] * 0.5 : CESQ_NONE;
+    out->nr_rsrp  = v[7] <= 126 ? -157.0 + v[7]      : CESQ_NONE;
+    out->nr_sinr  = v[8] <= 127 ? -23.0 + v[8] * 0.5 : CESQ_NONE;
+    return TRUE;
+}
+
+/* A +CESQ query: the reply, or what the handler took out of it */
+static gboolean
+cesq_query_finish (MMBaseModem  *self,
+                   GAsyncResult *res,
+                   Cesq         *out,
+                   GError      **error)
+{
+    MMBroadbandModemUnisocPrivate *priv = get_private (self);
+    const gchar                   *response;
+
+    response = mm_base_modem_at_command_finish (self, res, error);
+    if (!response)
+        return FALSE;
+    if (strstr (response, "+CESQ:"))
+        return parse_cesq (response, out, error);
+    if (!priv->have_cesq) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "No +CESQ response");
+        return FALSE;
+    }
+    *out = priv->last_cesq;
+    return TRUE;
+}
+
+/* RSRP -120 dBm (nothing usable) to -80 dBm (excellent) as 0-100% */
+static guint
+cesq_quality (const Cesq *c)
+{
+    gdouble rsrp;
+
+    rsrp = c->nr_rsrp != CESQ_NONE ? c->nr_rsrp : c->lte_rsrp;
+    if (rsrp == CESQ_NONE)
+        return 0;
+    return (guint) CLAMP ((rsrp + 120.0) * 100.0 / 40.0, 0.0, 100.0);
+}
+
+/*****************************************************************************/
+/* Signal quality (Modem interface) */
+
+static guint
+modem_load_signal_quality_finish (MMIfaceModem  *self,
+                                  GAsyncResult  *res,
+                                  GError       **error)
+{
+    GError *inner_error = NULL;
+    gssize  value;
+
+    value = g_task_propagate_int (G_TASK (res), &inner_error);
+    if (inner_error) {
+        g_propagate_error (error, inner_error);
+        return 0;
+    }
+    return (guint) value;
+}
+
+static void
+cesq_quality_ready (MMBaseModem  *self,
+                    GAsyncResult *res,
+                    GTask        *task)
+{
+    GError      *error = NULL;
+    Cesq         c;
+
+    if (!cesq_query_finish (self, res, &c, &error))
+        g_task_return_error (task, error);
+    else
+        g_task_return_int (task, cesq_quality (&c));
+    g_object_unref (task);
+}
+
+static void
+modem_load_signal_quality (MMIfaceModem        *self,
+                           GAsyncReadyCallback  callback,
+                           gpointer             user_data)
+{
+    mm_base_modem_at_command (MM_BASE_MODEM (self), "+CESQ", 3, FALSE,
+                              (GAsyncReadyCallback) cesq_quality_ready,
+                              g_task_new (self, NULL, callback, user_data));
+}
+
+/*****************************************************************************/
+/* Cell info (Modem interface), from the engineering-mode query +SPENGMD.
+ *
+ * AT+SPENGMD=0,<page>,<item> answers one line of fields separated by "-",
+ * each field a number or a ","-separated list; a negative number simply
+ * follows its separator ("-9963--1209" is -9963 and -1209).  Levels are in
+ * hundredths of a dB(m).  The pages read here:
+ *
+ *   0,14,1  NR serving cell: 0 band, 1 NR-ARFCN, 2 PCI, 3 RSRP, 4 RSRQ,
+ *           7 bandwidth (MHz), 8 gNB id, 9 NCI (low 32 bits), 15 SINR
+ *   0,14,2  NR neighbours, one list per field: band, NR-ARFCN, PCI, RSRP,
+ *           RSRQ, SINR
+ *   0,6,0   LTE serving cell: 0 band, 1 EARFCN, 2 PCI, 3 RSRP, 4 RSRQ,
+ *           7 bandwidth (0-5: 1.4, 3, 5, 10, 15, 20 MHz), 10 eNB id,
+ *           11 cell id, 29 TAC
+ *   0,0,6   LTE physical layer: 2 SINR (for the Signal interface: an LTE
+ *           cell info has no SINR)
+ *   0,6,6   LTE neighbours, one field per cell: EARFCN, PCI, RSRP, RSRQ, ...
+ *
+ * A RAT the modem is not on answers zeros.  Measured on NR SA: the NCI
+ * matches the 36-bit one +C5GREG reports once the gNB id's upper bits are
+ * put back (gNB id << 12, a 24-bit gNB id).  The LTE pages follow the layout
+ * UFI's own firmware tools read them with, and have not been seen on LTE
+ * here (the handset camps on NR SA).
+ */
+
+typedef enum {
+    SPENGMD_NR_SERVING,
+    SPENGMD_NR_NEIGHBOURS,
+    SPENGMD_LTE_SERVING,
+    SPENGMD_LTE_NEIGHBOURS,
+    SPENGMD_LAST
+} SpengmdPage;
+
+static const gchar *spengmd_commands[SPENGMD_LAST] = {
+    [SPENGMD_NR_SERVING]     = "+SPENGMD=0,14,1",
+    [SPENGMD_NR_NEIGHBOURS]  = "+SPENGMD=0,14,2",
+    [SPENGMD_LTE_SERVING]    = "+SPENGMD=0,6,0",
+    [SPENGMD_LTE_NEIGHBOURS] = "+SPENGMD=0,6,6",
+};
+
+typedef struct {
+    guint  page;
+    gchar *replies[SPENGMD_LAST];
+} CellInfoContext;
+
+static void
+cell_info_context_free (CellInfoContext *ctx)
+{
+    guint i;
+
+    for (i = 0; i < SPENGMD_LAST; i++)
+        g_free (ctx->replies[i]);
+    g_free (ctx);
+}
+
+/* The "-"-separated fields of a +SPENGMD reply */
+static GStrv
+spengmd_fields (const gchar *reply)
+{
+    GPtrArray   *fields;
+    GString     *cur;
+    gboolean     value_start = TRUE;
+    const gchar *p;
+
+    if (!reply)
+        return NULL;
+    while (*reply == '\r' || *reply == '\n' || *reply == ' ')
+        reply++;
+    if (!*reply)
+        return NULL;
+
+    fields = g_ptr_array_new ();
+    cur = g_string_new (NULL);
+    for (p = reply; *p && *p != '\r' && *p != '\n'; p++) {
+        if (*p == '-' && !value_start) {
+            g_ptr_array_add (fields, g_string_free (cur, FALSE));
+            cur = g_string_new (NULL);
+            value_start = TRUE;
+            continue;
+        }
+        g_string_append_c (cur, *p);
+        value_start = (*p == ',');
+    }
+    g_ptr_array_add (fields, g_string_free (cur, FALSE));
+    g_ptr_array_add (fields, NULL);
+    return (GStrv) g_ptr_array_free (fields, FALSE);
+}
+
+/* Value <i> of field <n> */
+static gboolean
+spengmd_value (GStrv f, guint n, guint i, gint64 *out)
+{
+    g_auto(GStrv) list = NULL;
+    gchar        *end = NULL;
+
+    if (!f || n >= g_strv_length (f))
+        return FALSE;
+    list = g_strsplit (f[n], ",", -1);
+    if (i >= g_strv_length (list) || !list[i][0])
+        return FALSE;
+    *out = g_ascii_strtoll (list[i], &end, 10);
+    return end && *end == '\0';
+}
+
+static guint
+spengmd_count (GStrv f, guint n)
+{
+    g_auto(GStrv) list = NULL;
+
+    if (!f || n >= g_strv_length (f))
+        return 0;
+    list = g_strsplit (f[n], ",", -1);
+    return g_strv_length (list);
+}
+
+static void
+cell_info_list_free (GList *list)
+{
+    g_list_free_full (list, g_object_unref);
+}
+
+static MMCellInfo *
+nr_cell_new (gboolean serving, gint64 arfcn, gint64 pci, gint64 rsrp, gint64 rsrq)
+{
+    MMCellInfo       *info;
+    g_autofree gchar *pci_str = NULL;
+
+    info = mm_cell_info_nr5g_new_from_dictionary (NULL);
+    mm_cell_info_set_serving (info, serving);
+    mm_cell_info_nr5g_set_nrarfcn (MM_CELL_INFO_NR5G (info), (guint) arfcn);
+    pci_str = g_strdup_printf ("%X", (guint) pci);
+    mm_cell_info_nr5g_set_physical_ci (MM_CELL_INFO_NR5G (info), pci_str);
+    mm_cell_info_nr5g_set_rsrp (MM_CELL_INFO_NR5G (info), rsrp / 100.0);
+    mm_cell_info_nr5g_set_rsrq (MM_CELL_INFO_NR5G (info), rsrq / 100.0);
+    return info;
+}
+
+static MMCellInfo *
+lte_cell_new (gboolean serving, gint64 earfcn, gint64 pci, gint64 rsrp, gint64 rsrq)
+{
+    MMCellInfo       *info;
+    g_autofree gchar *pci_str = NULL;
+
+    info = mm_cell_info_lte_new_from_dictionary (NULL);
+    mm_cell_info_set_serving (info, serving);
+    mm_cell_info_lte_set_earfcn (MM_CELL_INFO_LTE (info), (guint) earfcn);
+    pci_str = g_strdup_printf ("%X", (guint) pci);
+    mm_cell_info_lte_set_physical_ci (MM_CELL_INFO_LTE (info), pci_str);
+    mm_cell_info_lte_set_rsrp (MM_CELL_INFO_LTE (info), rsrp / 100.0);
+    mm_cell_info_lte_set_rsrq (MM_CELL_INFO_LTE (info), rsrq / 100.0);
+    return info;
+}
+
+static GList *
+cell_info_build (CellInfoContext *ctx)
+{
+    g_auto(GStrv) nr = spengmd_fields (ctx->replies[SPENGMD_NR_SERVING]);
+    g_auto(GStrv) nrn = spengmd_fields (ctx->replies[SPENGMD_NR_NEIGHBOURS]);
+    g_auto(GStrv) lte = spengmd_fields (ctx->replies[SPENGMD_LTE_SERVING]);
+    g_auto(GStrv) lten = spengmd_fields (ctx->replies[SPENGMD_LTE_NEIGHBOURS]);
+    GList        *list = NULL;
+    gboolean      have_lte = FALSE;
+    gint64        band, arfcn, pci, rsrp, rsrq, v, w;
+    guint         i, n;
+
+    if (spengmd_value (lte, 0, 0, &band) && band > 0 &&
+        spengmd_value (lte, 1, 0, &arfcn) && spengmd_value (lte, 2, 0, &pci) &&
+        spengmd_value (lte, 3, 0, &rsrp) && spengmd_value (lte, 4, 0, &rsrq)) {
+        static const guint lte_mhz10[] = { 14, 30, 50, 100, 150, 200 };
+        MMCellInfo       *info;
+
+        info = lte_cell_new (TRUE, arfcn, pci, rsrp, rsrq);
+        mm_cell_info_lte_set_serving_cell_type (MM_CELL_INFO_LTE (info), MM_SERVING_CELL_TYPE_PCELL);
+        if (spengmd_value (lte, 7, 0, &v) && v >= 0 && v < (gint64) G_N_ELEMENTS (lte_mhz10))
+            mm_cell_info_lte_set_bandwidth (MM_CELL_INFO_LTE (info), lte_mhz10[v] * 100000);
+        if (spengmd_value (lte, 10, 0, &v) && spengmd_value (lte, 11, 0, &w) && v > 0) {
+            g_autofree gchar *ci = g_strdup_printf ("%X", (guint) ((v << 8) | (w & 0xff)));
+
+            mm_cell_info_lte_set_ci (MM_CELL_INFO_LTE (info), ci);
+        }
+        if (spengmd_value (lte, 29, 0, &v) && v > 0) {
+            g_autofree gchar *tac = g_strdup_printf ("%X", (guint) v);
+
+            mm_cell_info_lte_set_tac (MM_CELL_INFO_LTE (info), tac);
+        }
+        list = g_list_append (list, info);
+        have_lte = TRUE;
+    }
+
+    if (spengmd_value (nr, 0, 0, &band) && band > 0 &&
+        spengmd_value (nr, 1, 0, &arfcn) && spengmd_value (nr, 2, 0, &pci) &&
+        spengmd_value (nr, 3, 0, &rsrp) && spengmd_value (nr, 4, 0, &rsrq)) {
+        MMCellInfo *info;
+
+        info = nr_cell_new (TRUE, arfcn, pci, rsrp, rsrq);
+        /* NR under an LTE anchor is EN-DC's secondary cell group */
+        mm_cell_info_nr5g_set_serving_cell_type (MM_CELL_INFO_NR5G (info),
+                                                 have_lte ? MM_SERVING_CELL_TYPE_PSCELL : MM_SERVING_CELL_TYPE_PCELL);
+        if (spengmd_value (nr, 15, 0, &v))
+            mm_cell_info_nr5g_set_sinr (MM_CELL_INFO_NR5G (info), v / 100.0);
+        if (spengmd_value (nr, 7, 0, &v) && v > 0)
+            mm_cell_info_nr5g_set_bandwidth (MM_CELL_INFO_NR5G (info), (guint) (v * 1000000));
+        if (spengmd_value (nr, 9, 0, &v) && v > 0) {
+            guint64           nci = (guint64) v & 0xffffffff;
+            g_autofree gchar *ci = NULL;
+
+            /* the upper 4 of the 36 bits, from a 24-bit gNB id */
+            if (spengmd_value (nr, 8, 0, &w) && w > 0 && ((((guint64) w << 12) & 0xfffff000) == (nci & 0xfffff000)))
+                nci |= ((guint64) w << 12) & G_GUINT64_CONSTANT (0xf00000000);
+            ci = g_strdup_printf ("%" G_GINT64_MODIFIER "X", nci);
+            mm_cell_info_nr5g_set_ci (MM_CELL_INFO_NR5G (info), ci);
+        }
+        list = g_list_append (list, info);
+    }
+
+    /* the serving cell shows up among the neighbours too; that is kept, as
+     * the modem reports it */
+    n = spengmd_count (nrn, 1);
+    for (i = 0; i < n; i++) {
+        MMCellInfo *info;
+
+        if (!spengmd_value (nrn, 1, i, &arfcn) || !spengmd_value (nrn, 2, i, &pci) ||
+            !spengmd_value (nrn, 3, i, &rsrp) || !spengmd_value (nrn, 4, i, &rsrq) ||
+            (arfcn == 0 && pci == 0 && rsrp == 0))
+            continue;
+        info = nr_cell_new (FALSE, arfcn, pci, rsrp, rsrq);
+        if (spengmd_value (nrn, 5, i, &v))
+            mm_cell_info_nr5g_set_sinr (MM_CELL_INFO_NR5G (info), v / 100.0);
+        list = g_list_append (list, info);
+    }
+
+    for (i = 0; lten && lten[i]; i++) {
+        MMCellInfo *info;
+
+        if (!spengmd_value (lten, i, 0, &arfcn) || !spengmd_value (lten, i, 1, &pci) ||
+            !spengmd_value (lten, i, 2, &rsrp) || !spengmd_value (lten, i, 3, &rsrq) ||
+            (arfcn == 0 && pci == 0 && rsrp == 0))
+            continue;
+        info = lte_cell_new (FALSE, arfcn, pci, rsrp, rsrq);
+        list = g_list_append (list, info);
+    }
+
+    return list;
+}
+
+static GList *
+modem_get_cell_info_finish (MMIfaceModem  *self,
+                            GAsyncResult  *res,
+                            GError       **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void cell_info_step (GTask *task);
+
+static void
+spengmd_ready (MMBaseModem  *self,
+               GAsyncResult *res,
+               GTask        *task)
+{
+    CellInfoContext  *ctx = g_task_get_task_data (task);
+    const gchar      *response;
+    g_autoptr(GError) error = NULL;
+
+    response = mm_base_modem_at_command_finish (self, res, &error);
+    if (response)
+        ctx->replies[ctx->page] = g_strdup (response);
+    else
+        mm_obj_dbg (self, "no reply to AT%s: %s", spengmd_commands[ctx->page], error->message);
+    ctx->page++;
+    cell_info_step (task);
+}
+
+static void
+cell_info_step (GTask *task)
+{
+    CellInfoContext *ctx = g_task_get_task_data (task);
+    GList           *list;
+
+    if (ctx->page < SPENGMD_LAST) {
+        mm_base_modem_at_command (MM_BASE_MODEM (g_task_get_source_object (task)),
+                                  spengmd_commands[ctx->page], 3, FALSE,
+                                  (GAsyncReadyCallback) spengmd_ready, task);
+        return;
+    }
+
+    list = cell_info_build (ctx);
+    if (!list)
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "No cell info in the +SPENGMD replies");
+    else
+        g_task_return_pointer (task, list, (GDestroyNotify) cell_info_list_free);
+    g_object_unref (task);
+}
+
+static void
+modem_get_cell_info (MMIfaceModem        *self,
+                     GAsyncReadyCallback  callback,
+                     gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_set_task_data (task, g_new0 (CellInfoContext, 1), (GDestroyNotify) cell_info_context_free);
+    cell_info_step (task);
+}
+
+/*****************************************************************************/
+/* Extended signal (Signal interface) */
+
+static gboolean
+signal_load_values_finish (MMIfaceModemSignal  *self,
+                           GAsyncResult        *res,
+                           MMSignal           **cdma,
+                           MMSignal           **evdo,
+                           MMSignal           **gsm,
+                           MMSignal           **umts,
+                           MMSignal           **lte,
+                           MMSignal           **nr5g,
+                           GError             **error)
+{
+    Cesq *c;
+
+    c = g_task_propagate_pointer (G_TASK (res), error);
+    if (!c)
+        return FALSE;
+
+    if (lte) {
+        *lte = NULL;
+        if (c->lte_rsrp != CESQ_NONE) {
+            *lte = mm_signal_new ();
+            mm_signal_set_rsrp (*lte, c->lte_rsrp);
+            if (c->lte_rsrq != CESQ_NONE)
+                mm_signal_set_rsrq (*lte, c->lte_rsrq);
+            if (c->lte_sinr != CESQ_NONE)
+                mm_signal_set_snr (*lte, c->lte_sinr);
+        }
+    }
+    if (nr5g) {
+        *nr5g = NULL;
+        if (c->nr_rsrp != CESQ_NONE) {
+            *nr5g = mm_signal_new ();
+            mm_signal_set_rsrp (*nr5g, c->nr_rsrp);
+            if (c->nr_rsrq != CESQ_NONE)
+                mm_signal_set_rsrq (*nr5g, c->nr_rsrq);
+            if (c->nr_sinr != CESQ_NONE)
+                mm_signal_set_snr (*nr5g, c->nr_sinr);
+        }
+    }
+    if (cdma)
+        *cdma = NULL;
+    if (evdo)
+        *evdo = NULL;
+    if (gsm)
+        *gsm = NULL;
+    if (umts)
+        *umts = NULL;
+    g_free (c);
+    return TRUE;
+}
+
+static void
+lte_phy_ready (MMBaseModem  *self,
+               GAsyncResult *res,
+               GTask        *task)
+{
+    Cesq          *c = g_task_get_task_data (task);
+    g_auto(GStrv)  f = NULL;
+    gint64         sinr;
+
+    f = spengmd_fields (mm_base_modem_at_command_finish (self, res, NULL));
+    if (spengmd_value (f, 2, 0, &sinr))
+        c->lte_sinr = sinr / 100.0;
+    g_task_return_pointer (task, g_memdup2 (c, sizeof (Cesq)), g_free);
+    g_object_unref (task);
+}
+
+static void
+cesq_values_ready (MMBaseModem  *self,
+                   GAsyncResult *res,
+                   GTask        *task)
+{
+    GError      *error = NULL;
+    Cesq        *c;
+
+    c = g_new0 (Cesq, 1);
+    if (!cesq_query_finish (self, res, c, &error)) {
+        g_free (c);
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+    /* the LTE SINR, which +CESQ does not have */
+    if (c->lte_rsrp != CESQ_NONE) {
+        g_task_set_task_data (task, c, g_free);
+        mm_base_modem_at_command (self, "+SPENGMD=0,0,6", 3, FALSE,
+                                  (GAsyncReadyCallback) lte_phy_ready, task);
+        return;
+    }
+    g_task_return_pointer (task, c, g_free);
+    g_object_unref (task);
+}
+
+static void
+signal_load_values (MMIfaceModemSignal  *self,
+                    GCancellable        *cancellable,
+                    GAsyncReadyCallback  callback,
+                    gpointer             user_data)
+{
+    mm_base_modem_at_command (MM_BASE_MODEM (self), "+CESQ", 3, FALSE,
+                              (GAsyncReadyCallback) cesq_values_ready,
+                              g_task_new (self, cancellable, callback, user_data));
+}
+
+/*****************************************************************************/
+/* SMS format setup (Messaging interface): the parent's, then the service
+ * centre written back as +CSCA? reports it (see the top) */
+
+static gboolean
+messaging_setup_sms_format_finish (MMIfaceModemMessaging  *self,
+                                   GAsyncResult           *res,
+                                   GError                **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+csca_set_ready (MMBaseModem  *self,
+                GAsyncResult *res,
+                GTask        *task)
+{
+    g_autoptr(GError) error = NULL;
+
+    if (!mm_base_modem_at_command_finish (self, res, &error))
+        mm_obj_warn (self, "couldn't write the SMS service centre back: %s", error->message);
+    else
+        mm_obj_dbg (self, "SMS service centre written back");
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+csca_query_ready (MMBaseModem  *self,
+                  GAsyncResult *res,
+                  GTask        *task)
+{
+    const gchar      *response;
+    const gchar      *value;
+    g_autofree gchar *cmd = NULL;
+    g_autoptr(GError) error = NULL;
+
+    response = mm_base_modem_at_command_finish (self, res, &error);
+    value = response ? strstr (response, "+CSCA:") : NULL;
+    if (!value) {
+        mm_obj_warn (self, "no SMS service centre to write back: %s",
+                     error ? error->message : "no +CSCA reply");
+        g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+        return;
+    }
+    value += strlen ("+CSCA:");
+    while (*value == ' ')
+        value++;
+    /* verbatim, "<address>",<type>: in the charset it was read in */
+    cmd = g_strdup_printf ("+CSCA=%.*s", (int) strcspn (value, "\r\n"), value);
+    mm_base_modem_at_command (self, cmd, 10, FALSE,
+                              (GAsyncReadyCallback) csca_set_ready, task);
+}
+
+static void
+parent_setup_sms_format_ready (MMIfaceModemMessaging *self,
+                               GAsyncResult          *res,
+                               GTask                 *task)
+{
+    GError *error = NULL;
+
+    if (!iface_modem_messaging_parent->setup_sms_format_finish (self, res, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+    mm_base_modem_at_command (MM_BASE_MODEM (self), "+CSCA?", 5, FALSE,
+                              (GAsyncReadyCallback) csca_query_ready, task);
+}
+
+static void
+messaging_setup_sms_format (MMIfaceModemMessaging *self,
+                            GAsyncReadyCallback    callback,
+                            gpointer               user_data)
+{
+    iface_modem_messaging_parent->setup_sms_format (
+        self,
+        (GAsyncReadyCallback) parent_setup_sms_format_ready,
+        g_task_new (self, NULL, callback, user_data));
+}
+
+/*****************************************************************************/
+/* Power */
+
+static const MMBaseModemAtCommand sim_on_sequence[] = {
+    { "+SFUN=2", 60, FALSE, mm_base_modem_response_processor_no_result_continue },
+    { "+SFUN=4", 60, FALSE, mm_base_modem_response_processor_no_result_continue },
+    { NULL }
+};
+
+static gboolean
+cfun_is_zero (const gchar *response)
+{
+    const gchar *p;
+
+    p = response ? strstr (response, "+CFUN:") : NULL;
+    if (!p)
+        return FALSE;
+    p += strlen ("+CFUN:");
+    while (*p == ' ')
+        p++;
+    return p[0] == '0' && !g_ascii_isdigit (p[1]);
+}
+
+static gboolean
+modem_power_finish (MMIfaceModem  *self,
+                    GAsyncResult  *res,
+                    GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+power_command_ready (MMBaseModem  *self,
+                     GAsyncResult *res,
+                     GTask        *task)
+{
+    GError *error = NULL;
+
+    if (!mm_base_modem_at_command_finish (self, res, &error))
+        g_task_return_error (task, error);
+    else
+        g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+power_sequence_ready (MMBaseModem  *self,
+                      GAsyncResult *res,
+                      GTask        *task)
+{
+    GError *error = NULL;
+
+    mm_base_modem_at_sequence_finish (self, res, NULL, &error);
+    if (error)
+        g_task_return_error (task, error);
+    else
+        g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+power_up_cfun_ready (MMBaseModem  *self,
+                     GAsyncResult *res,
+                     GTask        *task)
+{
+    const gchar *response;
+
+    response = mm_base_modem_at_command_finish (self, res, NULL);
+    if (cfun_is_zero (response)) {
+        mm_obj_dbg (self, "SIM and protocol stack off (+CFUN: 0): AT+SFUN=2, AT+SFUN=4");
+        mm_base_modem_at_sequence (self, sim_on_sequence, NULL, NULL,
+                                   (GAsyncReadyCallback) power_sequence_ready, task);
+        return;
+    }
+    mm_base_modem_at_command (self, "+CFUN=1", 30, FALSE,
+                              (GAsyncReadyCallback) power_command_ready, task);
+}
+
+static void
+modem_power_up (MMIfaceModem        *self,
+                GAsyncReadyCallback  callback,
+                gpointer             user_data)
+{
+    mm_base_modem_at_command (MM_BASE_MODEM (self), "+CFUN?", 5, FALSE,
+                              (GAsyncReadyCallback) power_up_cfun_ready,
+                              g_task_new (self, NULL, callback, user_data));
+}
+
+/* Low power and off are both flight mode: see the top */
+static void
+modem_power_down (MMIfaceModem        *self,
+                  GAsyncReadyCallback  callback,
+                  gpointer             user_data)
+{
+    mm_base_modem_at_command (MM_BASE_MODEM (self), "+CFUN=4", 30, FALSE,
+                              (GAsyncReadyCallback) power_command_ready,
+                              g_task_new (self, NULL, callback, user_data));
+}
+
+/* Initialization: the SIM on before anything reads it */
+
+static gpointer
+initialization_started_finish (MMBroadbandModem  *self,
+                               GAsyncResult      *res,
+                               GError           **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void
+init_sim_on_ready (MMBaseModem  *self,
+                   GAsyncResult *res,
+                   GTask        *task)
+{
+    GError *error = NULL;
+
+    mm_base_modem_at_sequence_finish (self, res, NULL, &error);
+    if (error) {
+        mm_obj_warn (self, "couldn't switch the SIM on: %s", error->message);
+        g_error_free (error);
+    }
+    g_task_return_pointer (task, g_task_get_task_data (task), NULL);
+    g_object_unref (task);
+}
+
+static void
+init_cfun_ready (MMBaseModem  *self,
+                 GAsyncResult *res,
+                 GTask        *task)
+{
+    const gchar *response;
+
+    response = mm_base_modem_at_command_finish (self, res, NULL);
+    if (cfun_is_zero (response)) {
+        mm_obj_msg (self, "SIM and protocol stack off (+CFUN: 0): switching them on");
+        mm_base_modem_at_sequence (self, sim_on_sequence, NULL, NULL,
+                                   (GAsyncReadyCallback) init_sim_on_ready, task);
+        return;
+    }
+    g_task_return_pointer (task, g_task_get_task_data (task), NULL);
+    g_object_unref (task);
+}
+
+static void
+parent_initialization_started_ready (MMBroadbandModem *self,
+                                     GAsyncResult     *res,
+                                     GTask            *task)
+{
+    GError   *error = NULL;
+    gpointer  ports_ctx;
+
+    ports_ctx = MM_BROADBAND_MODEM_CLASS (mm_broadband_modem_unisoc_parent_class)->initialization_started_finish (self, res, &error);
+    if (error) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+    /* handed back as is; the parent's initialization_stopped() releases it */
+    g_task_set_task_data (task, ports_ctx, NULL);
+    mm_base_modem_at_command (MM_BASE_MODEM (self), "+CFUN?", 5, FALSE,
+                              (GAsyncReadyCallback) init_cfun_ready, task);
+}
+
+static void
+initialization_started (MMBroadbandModem    *self,
+                        GAsyncReadyCallback  callback,
+                        gpointer             user_data)
+{
+    MM_BROADBAND_MODEM_CLASS (mm_broadband_modem_unisoc_parent_class)->initialization_started (
+        self,
+        (GAsyncReadyCallback) parent_initialization_started_ready,
+        g_task_new (self, NULL, callback, user_data));
+}
+
+/*****************************************************************************/
+/* Capabilities and IP families (Modem interface): no AT, see the top */
+
+static MMModemCapability
+modem_load_current_capabilities_finish (MMIfaceModem  *self,
+                                        GAsyncResult  *res,
+                                        GError       **error)
+{
+    GError *inner_error = NULL;
+    gssize  value;
+
+    value = g_task_propagate_int (G_TASK (res), &inner_error);
+    if (inner_error) {
+        g_propagate_error (error, inner_error);
+        return MM_MODEM_CAPABILITY_NONE;
+    }
+    return (MMModemCapability) value;
+}
+
+static void
+modem_load_current_capabilities (MMIfaceModem        *self,
+                                 GAsyncReadyCallback  callback,
+                                 gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_return_int (task, (MM_MODEM_CAPABILITY_GSM_UMTS |
+                              MM_MODEM_CAPABILITY_LTE |
+                              MM_MODEM_CAPABILITY_5GNR));
+    g_object_unref (task);
+}
+
+static MMBearerIpFamily
+modem_load_supported_ip_families_finish (MMIfaceModem  *self,
+                                         GAsyncResult  *res,
+                                         GError       **error)
+{
+    GError *inner_error = NULL;
+    gssize  value;
+
+    value = g_task_propagate_int (G_TASK (res), &inner_error);
+    if (inner_error) {
+        g_propagate_error (error, inner_error);
+        return MM_BEARER_IP_FAMILY_NONE;
+    }
+    return (MMBearerIpFamily) value;
+}
+
+static void
+modem_load_supported_ip_families (MMIfaceModem        *self,
+                                  GAsyncReadyCallback  callback,
+                                  gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_return_int (task, (MM_BEARER_IP_FAMILY_IPV4 |
+                              MM_BEARER_IP_FAMILY_IPV6 |
+                              MM_BEARER_IP_FAMILY_IPV4V6));
+    g_object_unref (task);
+}
+
+/*****************************************************************************/
+/* Unsolicited signal reports */
+
+static void
+cesq_received (MMPortSerialAt         *port,
+               GMatchInfo             *match_info,
+               MMBroadbandModemUnisoc *self)
+{
+    g_autofree gchar *line = NULL;
+    Cesq              c;
+
+    line = g_match_info_fetch (match_info, 0);
+    if (line && parse_cesq (line, &c, NULL)) {
+        get_private (self)->last_cesq = c;
+        get_private (self)->have_cesq = TRUE;
+        mm_iface_modem_update_signal_quality (MM_IFACE_MODEM (self), cesq_quality (&c));
+    }
+}
+
+static void
+setup_ports (MMBroadbandModem *self)
+{
+    MMPortSerialAt   *primary;
+    g_autoptr(GRegex) cesq = NULL;
+    g_autoptr(GRegex) csq = NULL;
+    g_autoptr(GRegex) vendor = NULL;
+    g_autoptr(GRegex) call = NULL;
+
+    MM_BROADBAND_MODEM_CLASS (mm_broadband_modem_unisoc_parent_class)->setup_ports (self);
+
+    primary = mm_base_modem_peek_port_primary (MM_BASE_MODEM (self));
+    if (!primary)
+        return;
+
+    /* Same format solicited and unsolicited: a line followed by its final
+     * result code is a reply (to AT+CESQ here, or to a client's AT+CSQ through
+     * Modem.Command) and stays in the response. */
+    cesq = g_regex_new ("\\r\\n\\+CESQ:[^\\r\\n]*\\r\\n(?!\\r\\n(OK|ERROR|\\+CME ERROR))",
+                        G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
+    csq = g_regex_new ("\\r\\n\\+CSQ:[^\\r\\n]*\\r\\n(?!\\r\\n(OK|ERROR|\\+CME ERROR))",
+                       G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
+    mm_port_serial_at_add_unsolicited_msg_handler (primary, cesq,
+                                                   (MMPortSerialAtUnsolicitedMsgFn) cesq_received,
+                                                   self, NULL);
+    mm_port_serial_at_add_unsolicited_msg_handler (primary, csq, NULL, NULL, NULL);
+
+    /* Vendor reports nobody asked for, which otherwise end up inside command
+     * replies (the model string read "+SPSLICEQUE:2|1,1|1 ^CONN: 11,2,2
+     * V1.0.1-B7"): SIM/storage indications, PDN and slice state, and the call
+     * control reports of the vendor RIL's protocol (^ORIG/^CONF/^CONN/^CEND/^DSCI,
+     * +SPCALLEXTINFO),
+     * the dial's "+CDU: <n>" and the VoLTE call state "+CLCCS:" -- calls are
+     * followed through +CLCC -- and the IMS registration report "+CIREGU:". */
+    vendor = g_regex_new ("\\r\\n\\+(SIND|ECIND|PRENWINFU|SPPSREADY|SPSLICEQUE|SPERROR|SPPCODATA|SPCALLEXTINFO|CIREGU|CDU|CLCCS):[^\\r\\n]*\\r\\n",
+                          G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
+    call = g_regex_new ("\\r\\n\\^(ORIG|CONF|CONN|CEND|DSCI):[^\\r\\n]*\\r\\n",
+                        G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
+    mm_port_serial_at_add_unsolicited_msg_handler (primary, vendor, NULL, NULL, NULL);
+    mm_port_serial_at_add_unsolicited_msg_handler (primary, call, NULL, NULL, NULL);
+}
+
+/*****************************************************************************/
+/* Create bearer (Modem interface) */
+
+static MMBaseBearer *
+modem_create_bearer_finish (MMIfaceModem  *self,
+                            GAsyncResult  *res,
+                            GError       **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void
+broadband_bearer_unisoc_new_ready (GObject      *source,
+                                   GAsyncResult *res,
+                                   GTask        *task)
+{
+    MMBaseBearer *bearer;
+    GError       *error = NULL;
+
+    bearer = mm_broadband_bearer_unisoc_new_finish (res, &error);
+    if (!bearer)
+        g_task_return_error (task, error);
+    else
+        g_task_return_pointer (task, bearer, g_object_unref);
+    g_object_unref (task);
+}
+
+static void
+modem_create_bearer (MMIfaceModem        *self,
+                     MMBearerProperties  *properties,
+                     GAsyncReadyCallback  callback,
+                     gpointer             user_data)
+{
+    mm_broadband_bearer_unisoc_new (MM_BROADBAND_MODEM_UNISOC (self),
+                                    properties,
+                                    NULL, /* cancellable */
+                                    (GAsyncReadyCallback) broadband_bearer_unisoc_new_ready,
+                                    g_task_new (self, NULL, callback, user_data));
+}
+
+/*****************************************************************************/
+
+MMBroadbandModemUnisoc *
+mm_broadband_modem_unisoc_new (const gchar  *device,
+                               const gchar  *physdev,
+                               const gchar **drivers,
+                               const gchar  *plugin,
+                               guint16       vendor_id,
+                               guint16       product_id)
+{
+    return g_object_new (MM_TYPE_BROADBAND_MODEM_UNISOC,
+                         MM_BASE_MODEM_DEVICE,             device,
+                         MM_BASE_MODEM_PHYSDEV,            physdev,
+                         MM_BASE_MODEM_DRIVERS,            drivers,
+                         MM_BASE_MODEM_PLUGIN,             plugin,
+                         MM_BASE_MODEM_VENDOR_ID,          vendor_id,
+                         MM_BASE_MODEM_PRODUCT_ID,         product_id,
+                         /* data only through the sipa_eth network interface */
+                         MM_BASE_MODEM_DATA_NET_SUPPORTED, TRUE,
+                         MM_BASE_MODEM_DATA_TTY_SUPPORTED, FALSE,
+                         NULL);
+}
+
+static void
+mm_broadband_modem_unisoc_init (MMBroadbandModemUnisoc *self)
+{
+}
+
+static void
+iface_modem_init (MMIfaceModemInterface *iface)
+{
+    iface->create_bearer = modem_create_bearer;
+    iface->create_bearer_finish = modem_create_bearer_finish;
+    iface->load_current_capabilities = modem_load_current_capabilities;
+    iface->load_current_capabilities_finish = modem_load_current_capabilities_finish;
+    iface->load_supported_ip_families = modem_load_supported_ip_families;
+    iface->load_supported_ip_families_finish = modem_load_supported_ip_families_finish;
+    iface->load_signal_quality = modem_load_signal_quality;
+    iface->load_signal_quality_finish = modem_load_signal_quality_finish;
+    iface->get_cell_info = modem_get_cell_info;
+    iface->get_cell_info_finish = modem_get_cell_info_finish;
+    iface->modem_power_up = modem_power_up;
+    iface->modem_power_up_finish = modem_power_finish;
+    iface->modem_power_down = modem_power_down;
+    iface->modem_power_down_finish = modem_power_finish;
+    iface->modem_power_off = modem_power_down;
+    iface->modem_power_off_finish = modem_power_finish;
+}
+
+static void
+iface_modem_messaging_init (MMIfaceModemMessagingInterface *iface)
+{
+    iface_modem_messaging_parent = g_type_interface_peek_parent (iface);
+
+    iface->setup_sms_format = messaging_setup_sms_format;
+    iface->setup_sms_format_finish = messaging_setup_sms_format_finish;
+}
+
+static void
+iface_modem_signal_init (MMIfaceModemSignalInterface *iface)
+{
+    iface->load_values = signal_load_values;
+    iface->load_values_finish = signal_load_values_finish;
+}
+
+static void
+mm_broadband_modem_unisoc_class_init (MMBroadbandModemUnisocClass *klass)
+{
+    MMBroadbandModemClass *broadband_modem_class = MM_BROADBAND_MODEM_CLASS (klass);
+
+    broadband_modem_class->setup_ports = setup_ports;
+    broadband_modem_class->initialization_started = initialization_started;
+    broadband_modem_class->initialization_started_finish = initialization_started_finish;
+
+    /* No ATZ: it leaves the CP's AT server silent */
+    broadband_modem_class->enabling_modem_init = NULL;
+    broadband_modem_class->enabling_modem_init_finish = NULL;
+    /* No +CPMS=: it leaves the CP's AT server silent too */
+    broadband_modem_class->sms_storages_fixed = TRUE;
+}
