#!/bin/sh
# New SMS on the E5 under OpenWrt: vibrate, and count it unread.
#
#   e5-sms-notify          listen (the procd service /etc/init.d/e5-sms-notify)
#   e5-sms-notify read     the messages have been seen: unread 0
#   e5-sms-notify test     what a new message does, without one
#
# ModemManager signals org.freedesktop.ModemManager1.Modem.Messaging.Added
# (object path, received) once per message, when its first part arrives;
# `received` is false for the messages it loads from storage at start and for
# the ones stored locally, which are not new.  The unread state is a file
# other programs read -- the info screen lights up and shows the message
# (e5-notify.sms.screen) and marks it in its status bar:
#   /tmp/run/e5-sms/unread   the paths of the unread messages, one per line
# The E5 has no notification LED (the PMIC's LED outputs drive nothing).
# Settings: /etc/config/e5-notify.
STATE=/tmp/run/e5-sms
UNREAD=$STATE/unread

cfg() { uci -q get "e5-notify.sms.$1" || echo "$2"; }

alert() {
	[ "$(cfg vibrate 1)" = 1 ] && e5-vibrate $(cfg pattern "250 150 250")
}

mkdir -p "$STATE"
touch "$UNREAD"

case "${1:-}" in
read)
	: > "$UNREAD"
	exit 0 ;;
test)
	alert
	exit 0 ;;
esac

# dbus-monitor prints the signal header, then its arguments, one per line:
#   signal ... member=Added
#      object path "/org/freedesktop/ModemManager1/SMS/3"
#      boolean true
# It writes into a FIFO this shell reads, not into a pipeline: procd stops a
# service by its main process, and a pipeline's other half would outlive it
# (and then vibrate a second time for every message).
FIFO=$STATE/monitor
rm -f "$FIFO" && mkfifo "$FIFO"
dbus-monitor --system \
	"type='signal',interface='org.freedesktop.ModemManager1.Modem.Messaging',member='Added'" \
	> "$FIFO" &
MON=$!
trap 'kill $MON 2>/dev/null; rm -f "$FIFO"; exit 0' TERM INT

sms=
while IFS= read -r line; do
	case "$line" in
	*"member=Added"*)
		sms= ;;
	*'object path "'*)
		sms=${line#*\"}; sms=${sms%\"*} ;;
	*"boolean true"*)
		[ -n "$sms" ] || continue
		grep -qx "$sms" "$UNREAD" || echo "$sms" >> "$UNREAD"
		logger -t e5-sms-notify "new message $sms"
		alert &
		sms= ;;
	*"boolean false"*)
		sms= ;;
	esac
done < "$FIFO"
# dbus-monitor ended (the bus restarted): procd starts this again
kill $MON 2>/dev/null
rm -f "$FIFO"
exit 1
