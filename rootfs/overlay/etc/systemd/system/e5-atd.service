[Unit]
Description=E5 modem AT channel keeper (see /opt/e5/e5-atd)
# the SIPC tty only exists once the vendor modem stack is up
ConditionPathExists=|/dev/stty_nr1
After=e5-vendor.service
Wants=e5-vendor.service
StartLimitIntervalSec=0

[Service]
ExecStart=/opt/e5/e5-atd
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
