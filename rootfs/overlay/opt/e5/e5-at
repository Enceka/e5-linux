#!/bin/sh
# Send an AT command through unisoc-cpd, the one process that owns the modem's
# AT channel in the G2 shape (the e5-atd fifo client this replaces is gone with
# e5-atd itself).
#
#   e5-at "AT+CSQ"            print the reply
#   e5-at -t 20 "AT+SFUN=4"   accepted for compatibility; the daemon owns the
#                             timeout (8 s), so the value is parsed and ignored
#
# Why not open /dev/stty_nr1 here: a second reader splits replies with the owner
# and makes the CP's PS task assert with "The queue was full" -- the whole point
# of the daemon.  Asking it by name keeps that promise: the command goes over
# /run/unisoc-cpd/cmd.sock and the daemon paces and serialises it.
set -u

have_cmd=0
while [ $# -gt 0 ]; do
    case "$1" in
        -t) shift; [ $# -gt 0 ] && shift ;;
        --) shift; have_cmd=1; break ;;
        *) have_cmd=1; break ;;
    esac
done

if [ "$have_cmd" = 0 ] || [ $# -eq 0 ]; then
    echo "usage: e5-at [-t SECONDS] AT+COMMAND" >&2
    exit 2
fi

exec /usr/local/bin/unisoc-cpd --mode native --profiles-dir /etc/unisoc-cpd \
    --socket /run/unisoc-cpd/cmd.sock at "$1"
