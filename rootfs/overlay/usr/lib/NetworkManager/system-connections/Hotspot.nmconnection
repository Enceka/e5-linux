# The E5's hotspot, as NetworkManager runs it: what Phosh's hotspot switch,
# UFI-TOOLS and `nmcli connection up Hotspot` start.
#
# Shipped read-only here, not in /etc: the overlay is copied over /etc at every
# boot and would undo a changed SSID or password.  NetworkManager writes an
# edited copy to /etc/NetworkManager/system-connections/, which shadows this one
# and survives.
#
# The AP is a port of br0, the LAN it shares with the USB port -- no IP settings
# here: dnsmasq on br0 hands out 192.168.9.x, the bearer's IPv6 /64 is
# advertised on br0 (e5-ipv6-share), and nat.nft forwards and filters (its
# bridge table keeps the management ports off wlan0).
#
# 5 GHz channel 149 at 80 MHz (5735-5815, centre 155), as the hostapd hotspot
# had.  Needs the patched network-manager (1.52.1+e5, rootfs/deb-patches/):
# trixie's computes that VHT80 centre as channel 154 and wpa_supplicant then
# fails the AP ("Interface initialization failed").  Channel 36 at 80 MHz came
# up with the stock package but no phone ever associated with it.
[connection]
id=Hotspot
uuid=6f2c9e5a-3b1d-4e57-9a0c-e5e5e5000001
type=wifi
interface-name=wlan0
# up at boot, like the hostapd hotspot was; NetworkManager brings back whichever
# of the hotspot and a joined Wi-Fi network was used last, and retries on its
# own when the WCN firmware refuses the first beacon
autoconnect=true
# the hotspot is what wlan0 does after boot: above any Wi-Fi network joined
# from Phosh (priority 0), which can still be chosen by hand -- wlan0 cannot
# be an access point and a station at once
autoconnect-priority=100
master=br0
slave-type=bridge

[wifi]
mode=ap
ssid=E5-Linux
band=a
channel=149
channel-width=80

[wifi-security]
key-mgmt=wpa-psk
proto=rsn
pairwise=ccmp
group=ccmp
pmf=1
# No WPS.  wpa_supplicant's AP mode adds a WPS element to the beacon, probe and
# association responses unless told otherwise, and this driver associates in
# firmware (device SME): with that element every phone saw E5-Linux and none
# could join -- nothing ever reached wpa_supplicant.  hostapd never sent one.
wps-method=1
psk=12345678

[bridge-port]
