# e5-linux: general-purpose Linux (Ubuntu/systemd) additions for the Rongyue E5
# (Unisoc UMS9621 / qogirn6lite / ums9158_1h10), merged on top of the device's
# Android defconfig arch/arm64/configs/e5_rongyue_defconfig.
#
# The base defconfig already carries everything the *Android* boot needs
# (CGROUPS, MODULES, BLK_DEV_LOOP, USB_CONFIGFS, EXT4_FS, F2FS_FS, OVERLAY_FS,
# TMPFS, PSTORE/PSTORE_RAM/PSTORE_PMSG/PSTORE_CONSOLE, USB_GADGET,
# USB_MUSB_HDRC=m, USB_MUSB_SPRD=m, PM_WAKELOCKS=y, SERIAL_AMBA_PL011).
# Only what a Linux userspace additionally needs is listed here.

# --- devtmpfs: the initramfs cannot populate /dev without it
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- configfs: the initramfs builds its own USB gadget (NCM + ACM) through it
CONFIG_CONFIGFS_FS=y

# --- USB gadget: NCM network + CDC-ACM console, built in so the console does not
#     depend on module load order. musb itself stays a module (stock order).
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_F_ECM=y
CONFIG_USB_F_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ACM=y

# --- Android restricts usermode helpers to one static binary; Linux needs
#     /proc/sys/kernel/hotplug and the firmware loader
# CONFIG_STATIC_USERMODEHELPER is not set
CONFIG_UEVENT_HELPER=y
CONFIG_UEVENT_HELPER_PATH=""
CONFIG_FW_LOADER_USER_HELPER=y

# --- systemd prerequisites missing from the Android defconfig
CONFIG_FHANDLE=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUTOFS_FS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_BPF=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_NAMESPACES=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_KCMP=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_AIO=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SYSVIPC=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_RT_GROUP_SCHED=y

# --- kernel-image handling for the Linux rootfs (kmod, initramfs tools)
CONFIG_MODULE_COMPRESS_NONE=y
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_MODULE_UNLOAD=y

# --- networking: nftables/NAT for USB tethering, plus the usual stack
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_BRIDGE=y
CONFIG_NF_TABLES_SET=y
CONFIG_NFT_CT=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_HASH=y
CONFIG_NFT_CONNLIMIT=y
CONFIG_NFT_SOCKET=y
CONFIG_NFT_TPROXY=y
CONFIG_NFT_FLOW_OFFLOAD=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_NETDEV=y
CONFIG_NFT_FWD_NETDEV=y
CONFIG_NFT_BRIDGE_META=y
CONFIG_NFT_BRIDGE_REJECT=y
CONFIG_NF_FLOW_TABLE=y
CONFIG_NF_FLOW_TABLE_INET=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VLAN_8021Q=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_VXLAN=y
CONFIG_TUN=y
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_PACKET_DIAG=y
CONFIG_UNIX_DIAG=y
CONFIG_INET_DIAG=y

# --- storage / filesystems a distribution expects
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_BTRFS_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_ISO9660_FS=y
CONFIG_UDF_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
CONFIG_MSDOS_FS=y
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y
CONFIG_NFS_FS=m
CONFIG_NFS_V4=m
CONFIG_CIFS=m

# --- swap / memory (the E5 has 4 GiB of RAM; zram is the usual escape hatch)
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_ZSWAP=y
CONFIG_FRONTSWAP=y
CONFIG_CLEANCACHE=y
CONFIG_SWAP=y

# --- crypto user APIs (cryptsetup, TLS, iwd)
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_AEAD=y
CONFIG_CRYPTO_USER_API_RNG=y
CONFIG_TLS=y
CONFIG_DM_CRYPT=y
CONFIG_DM_VERITY=y

# --- userspace hardware access
CONFIG_I2C_CHARDEV=y
CONFIG_SPI_SPIDEV=y
CONFIG_GPIO_SYSFS=y
CONFIG_HWMON=y
CONFIG_THERMAL=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_IDLE=y

# --- USB host devices (serial adapters, ethernet, storage, audio)
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_OPTION=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_STORAGE=m
CONFIG_USB_HID=y
CONFIG_USB_ACM=y

# --- pixel/console output on the internal MIPI panel (best effort; the panel
#     driver comes from the stock DT)
#
#     CONFIG_FB is what the two below depend on, and the device defconfig does
#     not set it -- without it DRM_FBDEV_EMULATION and FRAMEBUFFER_CONSOLE are
#     silently dropped by olddefconfig and there is no /dev/fb0 (which is what
#     the fbdev Mali UMD needs).  The driver side is patched by
#     kernel/patches/0001-*: the vendor KMS driver never called
#     drm_fbdev_generic_setup() itself.
CONFIG_FB=y
CONFIG_FB_CMDLINE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
#
#     The console has to be carried in the kernel, not in the boot image: LK
#     merges the boot image's cmdline with its own bootargs and *its* parameters
#     win on duplicate keys, so the "console=tty0 loglevel=7" the image header
#     has always asked for never took effect -- /proc/consoles listed only
#     ttyS1 and ramoops, the VT never received a single printk, and the panel
#     showed an empty console with a cursor.  CONFIG_CMDLINE_EXTEND appends
#     this string after the bootloader's, where nothing can drop it.
CONFIG_CMDLINE="console=tty0 loglevel=6"
CONFIG_CMDLINE_EXTEND=y

# --- ION: what the r41p0 Mali fbdev UMD allocates its window buffers from
#     ARM's glibc Valhall r41p0 blob is a 2020-era build: it carries "/dev/ion"
#     and "query ion heap failed ret=%#x", so it predates dma-buf heaps.  Without
#     /dev/ion eglCreateWindowSurface fails with EGL_BAD_ALLOC (measured), while
#     EGL itself initialises fine.  The device's own Android build uses dma-heap
#     and never builds this driver, so its Kconfig/Makefile had to be wired up --
#     see kernel/patches/0003-*.
CONFIG_ION=y
CONFIG_ION_SYSTEM_HEAP=y
CONFIG_ION_CMA_HEAP=y
CONFIG_UNIX98_PTYS=y
CONFIG_LEGACY_PTYS=y

# --- GPU: panfrost drives the Mali-G57, so kbase has to let go of the node --
# The GPU node is "sprd,mali-natt" and both drivers match it (kbase in
# drivers/gpu/arm/midgard/mali_kbase_core_linux.c, panfrost through its
# dt_match).  kbase is built in by the vendor defconfig and probes first, so
# panfrost would never see the device; build it as a module and do not load it.
# Nothing in module-order.stock asks for mali_kbase, so the initramfs leaves it
# alone, which is the point -- and it also means `modprobe mali_kbase` (or
# putting this back to =y) returns the device to the vendor blob path
# (rootfs/overlay/opt/e5/gpu-mali-setup) without a rebuild.
#
# See docs/FINDINGS.md section 20.7: panfrost_sprd.c replays the power and
# clock sequencing that kbase's platform code used to do, and this is what
# makes panfrost able to bind at all.
CONFIG_MALI_MIDGARD=m

# --- WCN (Wi-Fi/BT) build variant ---------------------------------------------
# The vendor's Kbuild takes the WCN assert policy (and one qogirl6 reset-pad
# write) from Android's TARGET_BUILD_VARIANT, which a hand-run `make` never sets,
# so the driver came up with the "userdebug" behaviour: the loopcheck ping gives
# the chip 4 s to answer, and the first round that is missed dumps its memory and
# marks the SDIO card dead -- after which every start_marlin() is refused and both
# radios are dead until the next reboot.  Wi-Fi registered but every scan returned
# -EIO, Bluetooth could not power on.  The user variant resets the chip instead
# and carries on, which is what production Android runs; measured on the device,
# see docs/FINDINGS.md section 8.6 and the Kconfig help.
CONFIG_UNISOC_WCN_BSP_USER_VARIANT=y

# --- build speed: no DWARF/BTF for a bring-up kernel (kallsyms still gives
#     symbol names in oops/panic output)
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_BTF is not set

# --- SELinux stays built in (the vendor tree expects it) but is disabled from
#     the kernel command line; no policy is shipped in the Linux rootfs
CONFIG_DEFAULT_SECURITY_DAC=y

# --- watchdog -----------------------------------------------------------------
# The bootloader hands over with the SoC watchdog armed (LK logs "wdt was enabled
# by miscdata" and passes sprdboot.wdten=e551 / dswdten=enabled), and this tree's
# sprd_wdt_fiq driver only ever loads a new timeout from paths Android drives -- the
# driver's own .start/.set_timeout are the only writers of the load registers.  So
# nothing under Linux re-arms it and it fires roughly five minutes into every
# session (docs/FINDINGS.md section 9, measured at 295 s with the host idle).
#
# This one turned out not to be what fires (its counter-enable bit is clear -- see
# docs/FINDINGS.md section 9; the PMIC watchdog is the one that reset the machine).
# CONFIG_DEVMEM stays anyway: /dev/mem is what makes the watchdog registers readable
# from the initramfs for diagnostics like that.  Android's defconfig turns it off and
# nothing else here uses it.  Patching drivers/watchdog/*.c instead would dirty the
# kernel tree, and setlocalversion then appends -dirty, which changes the release
# string the modules must match.
CONFIG_DEVMEM=y
