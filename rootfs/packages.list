# e5-linux root filesystem package set.
#
# Phosh is the session the E5 runs (etc/sddm.conf autologins phosh.desktop).  The
# device has a 480x320 DSI panel (lcd_st7365p_mipi_hdp) driven by the SPRD DRM/KMS
# driver, so the session is Wayland with the DRM backend.  Plasma Mobile is still
# installed and selectable from sddm -- docs/STATUS.md "Next" keeps whether it should
# stay as an open question.
#
# Rendering is on the Mali-G57 through panfrost (kernel/patches/0005, MALI_MIDGARD=m),
# which is what libgl1-mesa-dri / libegl-mesa0 carry.  llvmpipe is the fallback when a
# client asks for what Valhall v9 cannot do; no vendor blob is involved either way.

# --- base system ---
systemd
systemd-sysv
dbus
sudo
locales
tzdata
ca-certificates
kmod
udev
procps
psmisc
less
nano
htop
curl
wget
iproute2
iputils-ping
net-tools
e2fsprogs
dosfstools
parted

# --- Plasma Mobile session ---
plasma-mobile
plasma-workspace
kwin-wayland
kwin-x11
sddm
polkitd
qt6-wayland
xdg-desktop-portal
xdg-desktop-portal-kde
fonts-noto-core
fonts-noto-color-emoji
fonts-dejavu-core

# --- graphics: software rendering only ---
libgl1-mesa-dri
libegl-mesa0
libgles2
mesa-utils
libdrm-tests

# --- networking ---
network-manager
rfkill
# nftables: e5-mobile-data creates the NAT table for the USB/Wi-Fi clients and
# the hotspot's forwarding depends on it.  ethtool: the sipa driver reports wrong
# hardware checksums and mobile-data turns rx offload off.
nftables
ethtool

# --- session ---
# sddm autologins phosh.desktop (etc/sddm.conf in the overlay), so a fresh install
# without it comes up to a display manager that has no session to start.  Plasma
# Mobile stays installed and selectable.
phosh
phoc
phosh-osk-stub
squeekboard
foot

# --- Wi-Fi hotspot ---
# hostapd runs the AP and iw sets the regulatory domain (regdb-load): with a
# country and the signed regulatory.db the driver advertises 5725-5850 @ 80 MHz
# and hostapd reaches AP-ENABLED (docs/FINDINGS.md 20).
iw
hostapd

# --- UFI-TOOLS' terminal panel ---
ttyd

# --- audio (UCM for the UMS9621 codec is not ported; PipeWire is here so the
#     stack exists once it is) ---
pipewire
wireplumber
