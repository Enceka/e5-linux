[Unit]
Description=E5 Bluetooth: attach the WCN controller on /dev/ttyBT0
After=e5-vendor.service
# Stopped after bluetoothd, never alongside it: bluetoothd powers the adapter
# off on its way out, and that power-off is when the kernel sends the BT core
# its disable (btsprd, kernel/patches/0021).  Killed first, btattach closed
# ttyBT with the core still enabled, stop_marlin waited 30 s for the CP with
# the WCN power lock held, and Wi-Fi's teardown -- NetworkManager's at
# shutdown -- hung behind it.  Start order is unaffected in practice: this is
# Type=simple, so bluetoothd waits for the exec, not for the controller, and a
# wedged BT core still cannot hold up the boot (the lesson of
# e5-mobile-data.service, which once left the device with no session).
Before=bluetooth.service
ConditionPathExists=/dev/ttyBT0

[Service]
Type=simple
# Opening the tty is what powers MARLIN_BLUETOOTH on (mtty_open -> start_marlin),
# so btattach has to stay in the foreground and stay alive: it holds the HCI
# line discipline on the tty for as long as the controller exists.
ExecStart=/usr/bin/btattach -B /dev/ttyBT0 -S 3000000
Restart=always
RestartSec=5
# btattach is the process holding the HCI line discipline on the tty, and the
# tty is what keeps MARLIN_BLUETOOTH powered.  It *does* ignore SIGTERM: the
# shutdown on 2026-09-18 23:33 sat in "State 'final-sigterm' timed out. Killing."
# and then reported "Processes still around after final SIGKILL", which is what
# made the reboot feel slow.  Go straight to SIGKILL and do not wait.
KillSignal=SIGKILL
TimeoutStopSec=2

[Install]
WantedBy=multi-user.target
# Note: this image is booted with the overlay copied over /etc on every boot
# (boot/init stages /e5-overlay), so the enable symlink next to this unit in
# rootfs/overlay/ is what turns it on.  A rootfs built from scratch also gets
# `systemctl enable e5-bt-attach.service` from rootfs/configure-rootfs.sh.
