#!/bin/sh /etc/rc.common
# Cellular voice audio only; ModemManager owns all call-control operations.
START=98
STOP=9
USE_PROCD=1
start_service() {
 [ -x /usr/bin/python3 ] && [ -f /opt/e5/e5-call-audio.py ] || return 1
 procd_open_instance
 procd_set_param command /usr/libexec/e5-voice-audio
 procd_set_param respawn 3600 5 5
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}
