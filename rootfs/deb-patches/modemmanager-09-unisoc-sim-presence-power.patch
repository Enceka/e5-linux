Description: Unisoc cold power-up skips positively absent SIM slots
 Probe both CPIN contexts before the RIL power sequence, omit the absent slot's
 SIM/mode/protocol activation and restore the selected port context. Starting
 the empty first protocol stack when only SIM2 is inserted asserts this CP.
Author: e5-linux
Forwarded: no

--- a/src/plugins/unisoc/mm-broadband-modem-unisoc.c
+++ b/src/plugins/unisoc/mm-broadband-modem-unisoc.c
@@ -736,8 +736,12 @@
  * Every command goes on whatever it answers: the second slot may be empty.
  * The last one leaves the channel on the first card, for a port without the
  * card prefix. */
+static guint port_card (void);
 typedef struct {
     MMBaseModemAtCommandAlloc cmds[9];
+    gboolean present[2];
+    guint probe;
+    guint own;
 } CardsOnContext;
 
 static void
