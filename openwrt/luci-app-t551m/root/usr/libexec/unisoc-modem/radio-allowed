#!/bin/sh
# Canonical persistent per-slot RF policy. Missing means legacy both-enabled.
case ${1:-} in 0|1) ;; *) exit 2;; esac
policy=${UNISOC_RADIO_POLICY:-/etc/e5/sim-radio}
if [ ! -e "$policy" ]; then exit 0; fi
flags=$(cat "$policy") || exit 2
case "$flags" in '0 0'|'0 1'|'1 0'|'1 1') ;; *) exit 2;; esac
if [ "$1" = 0 ]; then [ "${flags% *}" = 1 ]; else [ "${flags#* }" = 1 ]; fi
