+/* An access point (or ad-hoc network) is a hotspot whatever its IP setup:
+ * one that is a port of a bridge shares the bridge's own NAT and DHCP and
+ * carries no IPv4 setting at all. */
+static gboolean
+connection_is_access_point (NMConnection *c)
+{
+        NMSettingWireless *sw;
+        const gchar *mode;
+
+        sw = nm_connection_get_setting_wireless (c);
+        mode = sw ? nm_setting_wireless_get_mode (sw) : NULL;
+        return g_strcmp0 (mode, NM_SETTING_WIRELESS_MODE_AP) == 0 ||
+               g_strcmp0 (mode, NM_SETTING_WIRELESS_MODE_ADHOC) == 0;
 }
 
 static gboolean
