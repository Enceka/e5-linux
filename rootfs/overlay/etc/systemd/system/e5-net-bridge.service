[Unit]
Description=E5 LAN bridge: usb0 and the hotspot on br0 (192.168.9.1/24)
Documentation=file:///opt/e5/net-bridge.sh
# Before everything that serves the LAN.  NetworkManager has to find br0 there to
# attach the hotspot to it, dnsmasq serves br0, and the management services bind
# to its addresses.
Before=network.target dnsmasq.service NetworkManager.service unisoc-cpd-web.service e5-telnetd.service
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/e5/net-bridge.sh
ExecReload=/opt/e5/net-bridge.sh

[Install]
WantedBy=multi-user.target
