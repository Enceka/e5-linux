{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenWrt Installer",
  "version": "1.0.0",
  "identifier": "org.openwrt.desktop-installer",
  "build": {"beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist"},
  "app": {
    "windows": [{"label":"main","title":"OpenWrt Installer","width":1120,"height":860,"minWidth":800,"minHeight":650,"center":true}],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://api.kanokano.cn; connect-src ipc: http://ipc.localhost"}
  },
  "bundle": {"active":false,"icon":["icons/icon.ico"],"windows":{"webviewInstallMode":{"type":"skip"}}}
}
