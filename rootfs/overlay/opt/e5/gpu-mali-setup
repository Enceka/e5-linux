#!/bin/sh
# e5-linux: point the session's compositor at the Mali GPU.
#
# What this installs, and why it is not simply "replace libEGL":
#
#  * The r32p0 Valhall G57 blob from the Allwinner A523 (TrimUI) firmware is a
#    full GBM + EGL + GLES userspace and it is accepted by this kernel's kbase
#    (docs/FINDINGS.md section 20).  It lives at /opt/mali/libMali-r32p0-sunxi.so
#    and is NOT part of this repository (vendor blob).
#  * It has no Wayland platform in its EGL client extensions, so it must not be
#    used by GTK apps -- they keep Mesa's software EGL.  Only phoc gets it, via
#    an explicit dynamic-loader --library-path (LD_LIBRARY_PATH would be
#    inherited by phoc's session child, which is exactly what we do not want).
#  * WLR_RENDERER=pixman in /etc/environment is unset for phoc so wlroots picks
#    its GLES2 renderer.
#  * /dev/dma_heap/* has to be openable by the session user -- see
#    /etc/udev/rules.d/60-e5-dma-heap.rules.
#
# usage: gpu-mali-setup [blob]        (default /opt/mali/libMali-r32p0-sunxi.so)
# undo : gpu-mali-revert
set -e
SRC=${1:-/opt/mali/libMali-r32p0-sunxi.so}
PREFIX=/opt/mali/gbm

[ -f "$SRC" ] || { echo "blob not found: $SRC" >&2; exit 1; }

mkdir -p "$PREFIX"
for lib in libEGL.so.1 libGLESv2.so.2 libGLESv1_CM.so.1 libgbm.so.1; do
    ln -sf "$SRC" "$PREFIX/$lib"
done

[ -f /usr/bin/phoc.orig ] || cp -a /usr/bin/phoc /usr/bin/phoc.orig
cat > /usr/bin/phoc <<'WRAPPER'
#!/bin/sh
# e5-linux: phoc with the Mali GBM/EGL userspace.  The real binary is
# /usr/bin/phoc.orig; run "gpu-mali-revert" to put it back.
unset WLR_RENDERER
exec /lib/ld-linux-aarch64.so.1 \
     --library-path /opt/mali/gbm:/usr/lib/aarch64-linux-gnu:/lib/aarch64-linux-gnu \
     /usr/bin/phoc.orig "$@"
WRAPPER
chmod 755 /usr/bin/phoc

chmod 666 /dev/dma_heap/* 2>/dev/null || true
echo "mali gbm enabled for phoc; restart the session (systemctl restart sddm)"
