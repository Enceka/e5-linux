#!/bin/sh
# udev counterpart of the OpenWrt hotplug filter: AT first, one SIM bank.
ls -d /sys/class/wwan/wwan*at* >/dev/null 2>&1 || exit 1
case "$(cat /sys/module/sipc_wwan/parameters/card 2>/dev/null):${1:-}" in
    0:sipa_eth[0-7]|1:sipa_eth[89]|1:sipa_eth1[0-5]) exit 0 ;;
    *) exit 1 ;;
esac
