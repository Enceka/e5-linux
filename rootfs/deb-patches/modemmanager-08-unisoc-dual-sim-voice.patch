+/* Unisoc shares an AT owner but each call retains its own source card.
+ * Keep the selection and basic ATD/ATA in one CP command, so signal polling
+ * cannot change SPACTCARD between selecting the card and the operation. */
+typedef struct { MMBaseCall *self; gboolean active; gboolean any; } CallBusy;
+static void call_other_live (MMBaseCall *call, CallBusy *ctx)
+{
+    MMCallState state = mm_base_call_get_state (call);
+    if (call == ctx->self || state == MM_CALL_STATE_UNKNOWN || state == MM_CALL_STATE_TERMINATED)
+        return;
+    ctx->any = TRUE;
+    if (state == MM_CALL_STATE_ACTIVE || state == MM_CALL_STATE_HELD ||
+        state == MM_CALL_STATE_DIALING || state == MM_CALL_STATE_RINGING_OUT)
+        ctx->active = TRUE;
+}
+static gboolean call_busy (MMBaseCall *self, gboolean accepting)
+{
+    MMCallList *list = NULL;
+    CallBusy ctx = { self, FALSE, FALSE };
+    if (!g_object_get_data (G_OBJECT (self->priv->modem), "e5-dual-sim-voice")) return FALSE;
+    g_object_get (self->priv->modem, MM_IFACE_MODEM_VOICE_CALL_LIST, &list, NULL);
+    if (list) { mm_call_list_foreach (list, (MMCallListForeachFunc)call_other_live, &ctx); g_object_unref (list); }
+    return accepting ? ctx.active : ctx.any;
+}
+
+static gchar *
+call_command_for_card (MMBaseCall *self, const gchar *command)
+{
+    guint slot = mm_gdbus_call_get_sim_slot (MM_GDBUS_CALL (self));
+    if (!slot || !g_object_get_data (G_OBJECT (self->priv->modem), "e5-dual-sim-voice"))
+        return g_strdup (command);
+    if (g_str_has_prefix (command, "AT")) command += 2;
+    return g_strdup_printf ("AT+SPACTCARD=%u;%s", slot - 1, command);
+}
+
+static void
+call_at_command (MMBaseCall *self, const gchar *command, guint timeout,
+                 GAsyncReadyCallback callback, gpointer user_data)
+{
+    gchar *selected = call_command_for_card (self, command);
+    mm_base_modem_at_command (self->priv->modem, selected, timeout, FALSE, callback, user_data);
+    g_free (selected);
+}
