# e5-linux root filesystem package set.
#
# Phosh is the session the E5 runs (etc/sddm.conf autologins phosh.desktop) and the only
# one installed: the Plasma Mobile half was dropped on 2026-09-19, together with the X11
# it dragged in.  The device has a 480x320 DSI panel (lcd_st7365p_mipi_hdp) driven by
# the SPRD DRM/KMS driver, so the session is Wayland with the DRM backend.
#
# Rendering is on the Mali-G57 through panfrost (kernel/patches/0005, MALI_MIDGARD=m),
# which is what libgl1-mesa-dri / libegl-mesa0 carry.  llvmpipe is the fallback when a
# client asks for what Valhall v9 cannot do; no vendor blob is involved either way.

# --- base system ---
systemd
systemd-sysv
dbus
sudo
locales
tzdata
ca-certificates
kmod
udev
procps
psmisc
less
nano
htop
curl
wget
iproute2
iputils-ping
net-tools
e2fsprogs
dosfstools
parted

# --- session: phosh on Wayland ---
# The whole X11/KDE side is gone -- no plasma-mobile, plasma-workspace, kwin-wayland,
# kwin-x11 or xdg-desktop-portal-kde.  Plasma was what put /usr/bin/X on this image,
# which is why etc/sddm.conf.d/10-e5.conf has to force DisplayServer=wayland
# (docs/STATUS.md, "Traps found the hard way").  qt6-wayland stays for sddm's own QML
# greeter; xdg-desktop-portal is the daemon, and a fresh install currently has no backend
# for it -- see "Open questions" in docs/STATUS.md.
sddm
polkitd
qt6-wayland
xdg-desktop-portal
fonts-noto-core
fonts-noto-color-emoji
fonts-dejavu-core

# --- graphics: software rendering only ---
libgl1-mesa-dri
libegl-mesa0
libgles2
mesa-utils
libdrm-tests

# --- networking ---
# No NetworkManager.  Everything is either systemd-networkd (usb0's management
# LAN and its DHCPServer, wlan0's 192.168.9.1) or one of our scripts
# (e5-bearer-up owns the baseband route, hotspot-start.sh owns wlan0 and
# dnsmasq), so NM managed nothing but the desktop's network panel.  It cost real
# time: NetworkManager-wait-online held network-online.target for minutes
# because NM autoconnects on sipa_dummy0 -- the sprd-wlan placeholder netdev,
# which needs no address at all -- and that in turn timed the hotspot's start
# script out and left the WCN chip powered down; its stop path also sat 32 s on
# WCN teardown during every reboot.
rfkill
# nftables: e5-mobile-data creates the NAT table for the USB/Wi-Fi clients and
# the hotspot's forwarding depends on it.  ethtool: the sipa driver reports wrong
# hardware checksums and mobile-data turns rx offload off.
nftables
ethtool
# dnsmasq-base is only the binary; the systemd unit the hotspot's start script
# restarts lives in the full dnsmasq package.  Without it a client associates
# and then never gets a lease -- which is exactly how a fresh
# --no-install-recommends build looked before this line existed.
dnsmasq

# --- phosh: the session itself ---
# sddm autologins phosh.desktop (etc/sddm.conf in the overlay), so a fresh install
# without these comes up to a display manager that has no session to start.
phosh
phoc
# phosh only Recommends gnome-session, and this list is installed with
# --no-install-recommends -- so /usr/bin/phosh-session, a wrapper that execs
# "gnome-session --session=phosh", exited without a word and the device came up
# with a display manager that could not start a session.  It is a Depends here.
gnome-session
# No RTC on this board.  Without something setting the clock the device boots
# years behind and apt refuses the mirror ("Not live until ..."), which cost two
# hand-set clocks today.  It is its own binary package, not part of systemd.
systemd-timesyncd
phosh-osk-stub
squeekboard
foot
# Portal backends used to arrive as Recommends of xdg-desktop-portal; a session
# whose apps ask for a portal has none without them.
xdg-desktop-portal-gtk
xdg-desktop-portal-phosh

# --- Wi-Fi hotspot ---
# hostapd runs the AP and iw sets the regulatory domain (regdb-load): with a
# country and the signed regulatory.db the driver advertises 5725-5850 @ 80 MHz
# and hostapd reaches AP-ENABLED (docs/FINDINGS.md 20).
iw
hostapd
# The signed regulatory.db e5-regdb-load installs: with it the driver advertises
# 5725-5850 @ 80 MHz and hostapd reaches AP-ENABLED.
wireless-regdb

# --- UFI-TOOLS ---
# Its backend is pure Python 3 standard library, so python3 is the whole
# requirement.  The terminal panel used to be ttyd; that package is gone from
# trixie (apt fails the install with "Unable to locate package ttyd"), so the
# overlay ships gotty instead -- one static aarch64 binary, same job, and
# UFI-TOOLS' ttyd_unit/ttyd_port point at its unit (gotty.service, port 1146).
python3

# --- field diagnostics ---
# Both were missed while chasing the modem, the daemon and the Wi-Fi by hand.
strace
lsof

# --- audio (UCM for the UMS9621 codec is not ported; PipeWire is here so the
#     stack exists once it is) ---
pipewire
wireplumber
# PulseAudio/ALSA compatibility for desktop apps (the Android HAL's paths do not
# exist here; PipeWire is what the session's clients will use).
pipewire-pulse
pipewire-alsa
# e5-bt-attach runs btattach/bluetoothd; bluez only arrived as someone else's
# dependency before.
bluez
