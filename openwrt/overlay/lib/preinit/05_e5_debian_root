# E5: this tree lives in a directory of the Debian root image, which the
# initramfs leaves mounted at /mnt/e5-disk (boot/init).  The hardware's
# firmware and the Android vendor subset are the Debian root's -- the files
# pulled from this very device (rootfs/pull-wcn-firmware.sh,
# rootfs/extract-android-vendor.sh) and the Debian-signed regulatory.db this
# kernel wants -- bound in before anything can ask for them, not copied, so
# there is one set.  The initramfs binds them before switch_root (boot/init:
# the WCN firmware is asked for at about that moment); this is the fallback
# for an initramfs that does not.
e5_bind_debian_root() {
	local d=/mnt/e5-disk src dst
	for pair in usr/lib/firmware:/lib/firmware opt/e5/android:/opt/e5/android; do
		src=$d/${pair%%:*}; dst=${pair#*:}
		[ -d "$src" ] || { echo "e5: missing $src" > /dev/kmsg; continue; }
		mkdir -p "$dst"
		grep -qs " $dst " /proc/mounts || mount -o bind "$src" "$dst"
	done
}

boot_hook_add preinit_main e5_bind_debian_root
