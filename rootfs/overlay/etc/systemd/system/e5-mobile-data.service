[Unit]
Description=E5 mobile data (AT commands + sipa_eth0 bearer)
After=e5-vendor.service network-pre.target multi-user.target
Wants=e5-vendor.service
ConditionPathExists=/dev/stty_nr1
# Deliberately *after* the boot targets.  This unit used to sit in "start running"
# for its whole TimeoutStartSec and then be restarted again (Restart=on-failure
# with StartLimitIntervalSec=0), while network.target, multi-user.target and sddm
# all waited on it -- so a modem that would not answer turned into a device that
# booted to a black screen with no session at all.  Bringing the bearer up is
# allowed to take minutes or to fail; the boot is not allowed to wait for it.
#
# It used to be After=graphical.target, which tied the modem to the session: on
# 2026-09-18 a boot whose session units were unhappy left the bearer unbuilt even
# though the AT channel was fine.  multi-user.target is reached independently and
# is still after the boot-critical path, so the same protection holds.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/e5/mobile-data up
ExecStop=/opt/e5/mobile-data down
# Bounded so a wedged AT channel cannot hold anything else up.  Reconnection is
# e5-mobile-data-watch.service's job, and it does not block the boot.
TimeoutStartSec=120
Restart=on-failure
RestartSec=30
StartLimitIntervalSec=300
StartLimitBurst=5

[Install]
WantedBy=multi-user.target graphical.target
