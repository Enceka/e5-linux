[Unit]
Description=E5 CP death watchdog (reboot when the AT channel stops answering)
Documentation=see docs/FINDINGS.md (baseband)
# There is no userspace modem reset on this board, so a dead CP is only
# recovered by a reboot -- with a stamp file that stops a boot loop.
After=e5-atd.service
Wants=e5-atd.service
ConditionPathExists=/dev/stty_nr1

[Service]
Type=simple
ExecStart=/opt/e5/cp-watchdog
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
