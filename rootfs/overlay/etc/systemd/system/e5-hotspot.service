[Unit]
# Wi-Fi hotspot (hostapd + dnsmasq on wlan0; clients are NATed out through the baseband by
# e5-mobile-data).  Needs the upstream-signed regulatory.db in the initramfs and
# `iw reg set CN`; docs/FINDINGS.md sections 20-20.3.  Ordering deliberately avoids
# network.target: e5-mobile-data is Before=network.target, and asking for both went
# through the target in a cycle ("Transaction order is cyclic").
Description=E5 Wi-Fi hotspot (hostapd on wlan0)
After=e5-vendor.service
Wants=e5-vendor.service
ConditionPathExists=/lib/firmware/wcnmodem.bin

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/e5/hotspot-start.sh
# -9 and "-": hostapd's shutdown path blocks in this driver (systemd spent 15 s
# in final-sigterm and then reported the unit failed with the process still
# running).  The kill powers the WCN chip down either way; the start script
# redoes the whole init, so a clean hostapd exit buys nothing.
ExecStop=-/usr/bin/pkill -9 -f hostapd
# The script waits for wlan0 (up to 120 s on a cold boot) and then for the WCN
# firmware to accept a beacon; 120 s was measured being hit exactly.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
