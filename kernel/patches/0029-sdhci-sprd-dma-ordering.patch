Subject: [PATCH] mmc: sdhci-sprd: order ADMA submission and completion

Match generic SDHCI MMIO ordering while preserving the vendor reset, reserved
register and interrupt-mask handling. Coherent descriptors still require ordering
before the command doorbell. Keep timing, clocks and runtime PM unchanged.

--- a/drivers/mmc/host/sdhci-sprd.c
+++ b/drivers/mmc/host/sdhci-sprd.c
@@ -195,7 +195,8 @@
 	if (unlikely(reg == SDHCI_MAX_CURRENT))
 		return SDHCI_SPRD_MAX_CUR;
 
-	return readl_relaxed(host->ioaddr + reg);
+	/* Shared SDHCI policy: order ADMA descriptors and DMA completion. */
+	return readl(host->ioaddr + reg);
 }
 
 static inline void sdhci_sprd_writel(struct sdhci_host *host, u32 val, int reg)
@@ -207,7 +208,7 @@
 	if (unlikely(reg == SDHCI_SIGNAL_ENABLE || reg == SDHCI_INT_ENABLE))
 		val = val & SDHCI_SPRD_INT_SIGNAL_MASK;
 
-	writel_relaxed(val, host->ioaddr + reg);
+	writel(val, host->ioaddr + reg);
 }
 
 static inline void sdhci_sprd_writew(struct sdhci_host *host, u16 val, int reg)
@@ -216,7 +217,7 @@
 	if (unlikely(reg == SDHCI_BLOCK_COUNT))
 		return;
 
-	writew_relaxed(val, host->ioaddr + reg);
+	writew(val, host->ioaddr + reg);
 }
 
 static inline void sdhci_sprd_writeb(struct sdhci_host *host, u8 val, int reg)
@@ -264,7 +265,7 @@
 			val |= SDHCI_HW_RESET_CARD;
 	}
 
-	writeb_relaxed(val, host->ioaddr + reg);
+	writeb(val, host->ioaddr + reg);
 }
 
 static inline void sdhci_sprd_sd_clk_off(struct sdhci_host *host)
