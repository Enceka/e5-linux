#!/bin/bash
# Mobile data on the E5's baseband, without Android RIL: AT commands on
# /dev/stty_nr1, data over sipa_eth<cid-1> (raw IP, NOARP), address from
# AT+CGCONTRDP.  The modem itself is booted by e5-vendor.service (Android's
# modem_control in a chroot) -- this only drives the radio and the bearer.
# usage: mobile-data up | down | status | watch | sim-reset
set -uo pipefail
DEV=${E5_AT_DEV:-/dev/stty_nr1}
CID=${E5_CID:-1}
IFACE=${E5_IFACE:-sipa_eth$((CID - 1))}
CONF=/etc/e5/mobile-data.conf
AT_LOCK=/run/e5-at.lock
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"
APN=${APN:-3gnet}

at() {
    local cmd=$1 t=${2:-5} line
    [ -c "$DEV" ] || return 1
    # One AT channel, several callers (the oneshot unit, the watcher, a human on
    # telnet).  Without this they steal each other's responses and a perfectly
    # good activation looks like "no IPv4 address from AT+CGCONTRDP".
    exec 9>"$AT_LOCK"
    flock -w 30 9 2>/dev/null || true
    exec 3<>"$DEV"
    while IFS= read -r -t 0.2 line <&3; do :; done
    printf '%s\r' "$cmd" >&3
    local end=$((SECONDS + t))
    while [ $SECONDS -lt $end ]; do
        IFS= read -r -t 1 line <&3 || continue
        line=${line%$'\r'}
        [ -z "$line" ] && continue
        echo "$line"
        case "$line" in OK|ERROR|+CME\ ERROR*|+CMS\ ERROR*|CONNECT*|NO\ CARRIER) break ;; esac
    done
    # close both fds for real (a subshell close would not release the flock), but
    # only if they are open -- otherwise the shell complains about fd 3/9
    [ -e /proc/self/fd/3 ] && exec 3>&-
    [ -e /proc/self/fd/9 ] && exec 9>&-
    return 0
}

radio_on() {
    at 'AT+CFUN?' | grep -q '+CFUN: 1' && return 0
    at 'AT+SFUN=2' 10 >/dev/null
    at 'AT+SFUN=4' 40 >/dev/null
}

wait_registered() {
    local n
    # the first registration after a cold modem boot can take a minute or two
    for n in $(seq 1 60); do
        at 'AT+CEREG?' | grep -qE '\+CEREG: [0-9],(1|5)' && return 0
        [ $((n % 5)) -eq 0 ] && radio_on
        sleep 2
    done
    return 1
}

up() {
    [ -c "$DEV" ] || { echo "no AT channel $DEV (is e5-vendor.service running?)" >&2; exit 3; }
    rm -f /run/e5-mobile-data-down
    stty -F "$DEV" raw -echo 2>/dev/null || true
    radio_on
    wait_registered || { echo "not registered on the network" >&2; exit 1; }
    at "AT+CGDCONT?" | grep -q "CGDCONT: $CID," ||
        at "AT+CGDCONT=$CID,\"IPV4V6\",\"$APN\"" >/dev/null
    at "AT+CGACT?" | grep -q "+CGACT: $CID,1" || at "AT+CGACT=1,$CID" 30 >/dev/null
    local rdp addrmask ip4 mask dns1 dns2 prefix n
    # the context can take a moment to acquire its address after CGACT
    for n in 1 2 3 4 5 6; do
        rdp=$(at "AT+CGCONTRDP=$CID" 6 | grep '^+CGCONTRDP:' | head -1)
        addrmask=$(echo "$rdp" | cut -d, -f4 | tr -d '"')
        case "$addrmask" in ""|0.0.0.0*) sleep 3 ;; *) break ;; esac
    done
    ip4=$(echo "$addrmask" | cut -d. -f1-4)
    mask=$(echo "$addrmask" | cut -d. -f5-8)
    dns1=$(echo "$rdp" | cut -d, -f6 | tr -d '"')
    dns2=$(echo "$rdp" | cut -d, -f7 | tr -d '"')
    [ -n "$ip4" ] || { echo "no IPv4 address from AT+CGCONTRDP" >&2; exit 1; }
    at "AT+CGDATA=\"M-ETHER\",$CID" 10 | grep -q CONNECT || true
    prefix=$(python3 -c "import ipaddress,sys;print(ipaddress.IPv4Network('0.0.0.0/'+sys.argv[1]).prefixlen)" "$mask" 2>/dev/null || echo 32)
    ip link set "$IFACE" up
    ip addr flush dev "$IFACE"
    ip addr add "$ip4/$prefix" dev "$IFACE"
    ip route replace default dev "$IFACE" metric 100
    # The carrier's resolvers only exist behind this bearer, so they must not be
    # the only entries: when the PDP context drops, or when traffic is going out
    # over Wi-Fi instead, they become unreachable and *every* lookup fails even
    # though the routing table is perfectly fine.  Public resolvers answer over
    # both paths and go first; the carrier's stay as a secondary.
    {
        printf 'nameserver 223.5.5.5\n'
        printf 'nameserver 119.29.29.29\n'
        [ -n "$dns1" ] && printf 'nameserver %s\n' "$dns1"
        [ -n "$dns2" ] && printf 'nameserver %s\n' "$dns2"
    } > /etc/resolv.conf
    # share the bearer with the USB LAN clients: this image has nftables (no
    # iptables) and sipa_eth0 is a raw-IP link, so clamp the MSS as well
    sysctl -qw net.ipv4.ip_forward=1
    if command -v nft >/dev/null 2>&1; then
        nft -f - <<NFT
table ip e5_nat
delete table ip e5_nat
table ip e5_nat {
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "$IFACE" masquerade
    }
    chain forward {
        type filter hook forward priority filter; policy accept;
        tcp flags syn tcp option maxseg size set rt mtu
    }
}
NFT
    fi
    local op
    op=$(at 'AT+COPS?' | sed -n 's/^+COPS: [0-9],[0-9],"\([^"]*\)".*/\1/p')
    echo "mobile data up on $IFACE ($ip4/$prefix, $op)"
}

down() {
    touch /run/e5-mobile-data-down
    nft delete table ip e5_nat 2>/dev/null || true
    ip route del default dev "$IFACE" 2>/dev/null || true
    ip addr flush dev "$IFACE" 2>/dev/null || true
    ip link set "$IFACE" down 2>/dev/null || true
    at "AT+CGACT=0,$CID" 10 >/dev/null || true
}

# AcT as +CEREG/+COPS report it (3GPP 27.007: 7 is E-UTRA, 11 is NR SA,
# 13 is E-UTRA-NR dual connectivity).
act_name() {
    case "$1" in
        0) echo GSM;; 2) echo UTRAN;; 3) echo TD-SCDMA;; 4) echo CDMA2000;;
        5|6) echo CDMA2000-EVDO;; 7) echo LTE;; 9|10) echo LTE-CA;;
        11) echo "NR (5G SA)";; 13) echo "LTE+NR (EN-DC/NSA)";;
        *) echo "AcT $1";;
    esac
}

status() {
    local cereg act spr
    echo "channel: $DEV  interface: $IFACE"
    at 'AT+CFUN?' 2>/dev/null | head -1
    at 'AT+CPIN?' 2>/dev/null | head -1
    cereg=$(at 'AT+CEREG?' 2>/dev/null | grep CEREG | head -1)
    if [ -n "$cereg" ]; then
        act=$(echo "$cereg" | sed 's/.*,//')
        echo "$cereg   -> $(act_name "$act")"
    fi
    spr=$(at 'AT+SPRAT?' 2>/dev/null | grep SPRAT | head -1)
    [ -n "$spr" ] && echo "$spr   -> camped RAT (read-only on this AT set)"
    at 'AT+COPS?' 2>/dev/null | grep COPS | head -1
    at 'AT+CSQ' 2>/dev/null | grep CSQ | head -1
    ip -br addr show "$IFACE" 2>/dev/null
    ip route show default 2>/dev/null | head -3
}

sim_reset() {
    stty -F "$DEV" raw -echo 2>/dev/null || true
    at 'AT+SFUN=5' 20; at 'AT+SFUN=3' 10; sleep 2; at 'AT+SFUN=2' 10; at 'AT+SFUN=4' 40
    local n
    for n in $(seq 1 30); do at 'AT+CPIN?' | grep -q READY && break; sleep 2; done
    at 'AT+CPIN?'
}

# The modem firmware resets itself now and then; it comes back with the radio off
# and no PDP context, so check the bearer and rebuild it when it is gone.
watch() {
    local fails=0
    # a boot where the modem was not ready yet leaves the bearer down and the
    # oneshot unit failed; repair it here rather than waiting for the first check
    [ -e /run/e5-mobile-data-down ] || up || true
    while :; do
        sleep 30
        [ -e /run/e5-mobile-data-down ] && continue
        # Registration is not enough.  When the PDP context deactivates the
        # interface keeps its address and the default route keeps blackholing
        # traffic, so "registered but no bearer" looks perfectly healthy here and
        # nothing ever reconnects -- the only symptom is that the internet stops.
        # Ask about the context itself.
        if ! at 'AT+CEREG?' 2>/dev/null | grep -qE '\+CEREG: [0-9],(1|5)'; then
            fails=$((fails + 1))
        elif ! at 'AT+CGACT?' 2>/dev/null | grep -qE "\+CGACT: *$CID,1"; then
            fails=$((fails + 1))
        elif ! ip -br addr show "$IFACE" 2>/dev/null | grep -q 'UP'; then
            fails=$((fails + 1))
        else
            fails=0
        fi
        if [ $fails -ge 2 ]; then
            echo "watcher: bearer lost, reconnecting"
            # Drop the dead route before retrying, and do it inline rather than
            # via down(): down() also touches /run/e5-mobile-data-down, which is
            # what makes the watcher skip its checks, so calling it here would
            # disable the watcher for good.  With the route gone, a failed
            # reconnect leaves Wi-Fi as the working default instead of a
            # blackhole.
            ip route del default dev "$IFACE" 2>/dev/null || true
            ip addr flush dev "$IFACE" 2>/dev/null || true
            up || true
            fails=0
        fi
    done
}

case "${1:-}" in
    up) up ;;
    down) down ;;
    status) status ;;
    sim-reset) sim_reset ;;
    watch) watch ;;
    *) echo "usage: mobile-data up|down|status|watch|sim-reset" >&2; exit 2 ;;
esac
