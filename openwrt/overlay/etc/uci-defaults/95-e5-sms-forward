#!/bin/sh
# The SMS forward's section in /etc/config/e5-notify, for a configuration kept
# from an image before it (an update keeps /etc/config): off, a JSON webhook.
if ! uci -q get e5-notify.forward >/dev/null; then
uci -q batch <<'UCI'
set e5-notify.forward=forward
set e5-notify.forward.enabled='0'
set e5-notify.forward.url=''
set e5-notify.forward.method='POST'
set e5-notify.forward.content_type='application/json'
set e5-notify.forward.body='{"from":"{from}","text":"{text}","time":"{time}","sim":"{sim}","device":"{device}"}'
set e5-notify.forward.timeout='10'
commit e5-notify
UCI
fi
uci -q get e5-notify.forward.mode >/dev/null || uci set e5-notify.forward.mode='shared'
for section in forward_sim1 forward_sim2; do
    uci -q get e5-notify.$section >/dev/null && continue
    uci set e5-notify.$section=forward
    uci set e5-notify.$section.enabled='0'
    uci set e5-notify.$section.method='POST'
    uci set e5-notify.$section.content_type='application/json'
    uci set e5-notify.$section.body='{"from":"{from}","text":"{text}","time":"{time}","sim":"{sim}","device":"{device}"}'
    uci set e5-notify.$section.timeout='10'
done
uci commit e5-notify
exit 0
