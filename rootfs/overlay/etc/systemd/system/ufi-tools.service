[Unit]
Description=UFI-TOOLS web backend (Linux / E5-LINUX port)
Documentation=file:///usr/share/doc/ufi-tools/README.md
# The AT bridge wants the modem channels up, and the goform feature wants the
# network: start after both, but never require them, so a device without a modem
# still serves the UI.
After=network-online.target e5-vendor.service
Wants=network-online.target
# AT goes through /opt/e5/e5-at, i.e. through ModemManager (docs/FINDINGS.md
# 37).  No Wants= on the modem's owner: pulling unisoc-cpd in, as this unit
# once did, would now stop ModemManager's AT port (e5-sipc-wwan.service).
After=ModemManager.service

[Service]
Type=simple
# The port binds 2333 by default; the token and every setting live here.
Environment=UFI_TOOLS_DATA=/var/lib/ufi-tools
Environment=PYTHONPATH=/usr/lib/ufi-tools
Environment=UFI_TOOLS_WWW=/usr/share/ufi-tools/www
WorkingDirectory=/usr/lib/ufi-tools
ExecStart=/usr/bin/python3 -m ufitools serve
Restart=always
RestartSec=5

# The service drives systemd units (hotspot, mobile data), talks to the AT
# broker and runs operator scripts, so it needs to be root.  It is bound to the
# management LAN and protected by the UFI-TOOLS token; see README.md.
User=root

# A watchdog reboot must not wait on vendor teardown (docs/STATUS.md, "32 s
# shutdown"): stop fast and hard.
KillSignal=SIGTERM
TimeoutStopSec=5
FinalKillSignal=SIGKILL

# Modest hardening that does not break the hardware bridges.
NoNewPrivileges=no
ProtectHome=no
ProtectSystem=no
PrivateTmp=no

[Install]
WantedBy=multi-user.target
