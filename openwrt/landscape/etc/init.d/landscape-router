#!/bin/sh /etc/rc.common
# Landscape Router (https://landscape.whileaway.dev), installed only in an
# image built with E5_LANDSCAPE=1.  It is the router: it owns the interfaces,
# the DHCP server and DNS on port 53, so OpenWrt's own dnsmasq/odhcpd and
# netifd's address configuration must be off (99-landscape below).  The
# webserver runs in the foreground under procd; its database and web UI are
# under /etc/landscape-router.
START=19
STOP=90
USE_PROCD=1

start_service() {
	# Landscape locks its BPF maps and sockets: the manual's
	# LimitMEMLOCK=infinity.  procd applies this rlimit to the child it
	# starts; a ulimit here would only change this init script's own shell.
	# (Only this daemon; the rest of the image keeps the OpenWrt default.)
	# Landscape pins its maps under /sys/fs/bpf.  Nothing on OpenWrt mounts
	# bpffs at boot, and the sysfs placeholder then makes the pin fail with
	# ENOENT (landscape.whileaway.dev/zh/faq/alpine-bpffs).
	mountpoint -q /sys/fs/bpf || mount -t bpf bpf /sys/fs/bpf 2>/dev/null
	procd_open_instance
	procd_set_param command /usr/sbin/landscape-webserver \
		--config-dir /etc/landscape-router \
		--web /etc/landscape-router/static \
		--port 6300 --https 6443 --address 0.0.0.0 \
		--log_path /var/log/landscape-router --log-output-in-terminal false
	procd_set_param limits memlock=unlimited
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger landscape-router
}
