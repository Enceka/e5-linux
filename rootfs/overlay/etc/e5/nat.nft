# Declarative, so re-running it is a no-op rather than a "File exists" error.
#
# The hotspot's clients get 192.168.9.1 as router and DNS from dnsmasq, and the
# USB management LAN gets 192.168.77.1 -- but nothing was masquerading them out
# of the baseband, so a connected phone could not reach anything.  The unit that
# used to do this (e5-mobile-data) was replaced by e5-bearer-up and the rules went
# with it.
table ip e5nat {
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        ip saddr 192.168.9.0/24 oifname "sipa_eth*" masquerade
        ip saddr 192.168.77.0/24 oifname "sipa_eth*" masquerade
    }
}

# IPv6 is not NATed: hotspot clients get public addresses from the bearer's /64
# (opt/e5/e5-ipv6-share), so this is the firewall a home router would have --
# replies and the ICMPv6 that path MTU and diagnostics need come in, new
# connections from the internet do not.
table inet e5fw6 {
    chain forward {
        type filter hook forward priority filter; policy accept;
        meta nfproto ipv6 iifname "sipa_eth*" ct state established,related accept
        meta nfproto ipv6 iifname "sipa_eth*" icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, echo-request } accept
        meta nfproto ipv6 iifname "sipa_eth*" counter drop
    }
}
