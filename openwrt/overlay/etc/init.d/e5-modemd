#!/bin/sh /etc/rc.common
# The CP log daemon's part in a CP reset (/usr/sbin/e5-modemd): after an assert
# modem_control waits for it before it resets the CP -- 300 s without it.  It
# connects once modem_control is up, and is restarted when that goes away.
START=22
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/e5-modemd
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
