+    ctx = g_task_get_task_data (task);
+    /* Only a positively absent slot is skipped. CPIN is readable before
+     * SFUN here; powering an absent first stack asserts this CP when only
+     * SIM2 is inserted (mnphone_api.c:7048). Keep the two-card RIL order. */
+    if (ctx->present[0]) {
+        ctx->cmds[n].command = g_strdup ("+SPACTCARD=0;+SFUN=2");
+        ctx->cmds[n++].timeout = 60;
